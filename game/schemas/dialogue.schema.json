{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/DialogueFile",
  "definitions": {
    "DialogueFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "with": {
          "$ref": "#/definitions/Id",
          "description": "Personatge principal (amb qui parles)."
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/definitions/Id"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/DialogueEntryDef"
              }
            }
          ],
          "description": "Node inicial. Si és una llista, s'agafa el primer que compleixi la condició: així un personatge et saluda diferent segons el que recorda."
        },
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/DialogueNodeDef"
          }
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "nodes",
        "start",
        "with"
      ]
    },
    "Id": {
      "type": "string"
    },
    "DialogueEntryDef": {
      "type": "object",
      "properties": {
        "if": {
          "$ref": "#/definitions/Condition"
        },
        "node": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": [
        "node"
      ],
      "additionalProperties": false
    },
    "Condition": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "flag": {
              "$ref": "#/definitions/Id"
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "flag"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "var": {
              "$ref": "#/definitions/Id"
            },
            "op": {
              "$ref": "#/definitions/CompareOp"
            },
            "value": {
              "$ref": "#/definitions/Scalar"
            }
          },
          "required": [
            "var",
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasItem": {
              "$ref": "#/definitions/Id"
            },
            "who": {
              "$ref": "#/definitions/Id"
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "hasItem"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protagonist": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "protagonist"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "remembers": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "fact": {
                  "$ref": "#/definitions/Id"
                },
                "atLeast": {
                  "type": "number"
                }
              },
              "required": [
                "who",
                "fact"
              ],
              "additionalProperties": false
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "remembers"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "relation": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "op": {
                  "$ref": "#/definitions/CompareOp"
                },
                "value": {
                  "type": "number"
                }
              },
              "required": [
                "who",
                "op",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "relation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quest": {
              "$ref": "#/definitions/Id"
            },
            "status": {
              "anyOf": [
                {
                  "$ref": "#/definitions/QuestStatus"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/QuestStatus"
                  }
                }
              ]
            }
          },
          "required": [
            "quest",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "objective": {
              "type": "object",
              "properties": {
                "quest": {
                  "$ref": "#/definitions/Id"
                },
                "objective": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "quest",
                "objective"
              ],
              "additionalProperties": false
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "objective"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "visited": {
              "$ref": "#/definitions/Id"
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "visited"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "inRoom": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "inRoom"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "seen": {
              "type": "object",
              "properties": {
                "dialogue": {
                  "$ref": "#/definitions/Id"
                },
                "node": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "dialogue",
                "node"
              ],
              "additionalProperties": false
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "seen"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "chosen": {
              "type": "object",
              "properties": {
                "dialogue": {
                  "$ref": "#/definitions/Id"
                },
                "node": {
                  "$ref": "#/definitions/Id"
                },
                "choice": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "dialogue",
                "node",
                "choice"
              ],
              "additionalProperties": false
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "chosen"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Condition"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Condition"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/definitions/Condition"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        }
      ]
    },
    "CompareOp": {
      "type": "string",
      "enum": [
        "==",
        "!=",
        ">",
        ">=",
        "<",
        "<="
      ]
    },
    "Scalar": {
      "type": [
        "number",
        "string",
        "boolean"
      ]
    },
    "QuestStatus": {
      "type": "string",
      "enum": [
        "inactive",
        "active",
        "completed",
        "failed"
      ]
    },
    "DialogueNodeDef": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DialogueLineDef"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Effect"
          },
          "description": "Efectes en entrar al node."
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DialogueChoiceDef"
          }
        },
        "goto": {
          "$ref": "#/definitions/Id",
          "description": "Sense opcions disponibles: salta a aquest node o acaba la conversa."
        }
      },
      "additionalProperties": false
    },
    "DialogueLineDef": {
      "type": "object",
      "properties": {
        "who": {
          "$ref": "#/definitions/SpeakerId"
        },
        "text": {
          "$ref": "#/definitions/TextKey"
        },
        "if": {
          "$ref": "#/definitions/Condition"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Effect"
          }
        },
        "sound": {
          "$ref": "#/definitions/SoundId",
          "description": "So que fa en dir la línia: un fitxer de `game/audio/sfx/` sense extensió. Pot dur variables entre claus, que es posen en acabar la interacció: `\"molla_{molla_tensio}\"` → `molla_3`."
        }
      },
      "required": [
        "who",
        "text"
      ],
      "additionalProperties": false
    },
    "SpeakerId": {
      "anyOf": [
        {
          "$ref": "#/definitions/Id"
        },
        {
          "type": "string",
          "const": "player"
        },
        {
          "type": "string",
          "const": "narrator"
        }
      ],
      "description": "`player` = el protagonista, `narrator` = text de narració."
    },
    "TextKey": {
      "type": "string",
      "description": "Clau d'un text a `game/locales/<idioma>/*.json`, p. ex. `\"dlg.pescador.hola\"`."
    },
    "Effect": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "setFlag": {
              "$ref": "#/definitions/Id"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "setFlag"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "setVar": {
              "$ref": "#/definitions/Id"
            },
            "value": {
              "$ref": "#/definitions/Scalar"
            }
          },
          "required": [
            "setVar",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "addVar": {
              "$ref": "#/definitions/Id"
            },
            "amount": {
              "type": "number"
            }
          },
          "required": [
            "addVar",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "giveItem": {
              "$ref": "#/definitions/Id"
            },
            "who": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "giveItem"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "takeItem": {
              "$ref": "#/definitions/Id"
            },
            "who": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "takeItem"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "remember": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "fact": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "who",
                "fact"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "remember"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "forget": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "fact": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "who",
                "fact"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "forget"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "relation": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "change": {
                  "type": "number"
                }
              },
              "required": [
                "who",
                "change"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "relation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "startQuest": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "startQuest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "completeObjective": {
              "type": "object",
              "properties": {
                "quest": {
                  "$ref": "#/definitions/Id"
                },
                "objective": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "quest",
                "objective"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "completeObjective"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "completeQuest": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "completeQuest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "failQuest": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "failQuest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ending": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "ending"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string"
            },
            "args": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/Scalar"
              }
            }
          },
          "required": [
            "event"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SoundId": {
      "type": "string",
      "description": "Nom d'un so de `game/audio/sfx/` (sense extensió), amb `{variable}` opcionals."
    },
    "DialogueChoiceDef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "text": {
          "$ref": "#/definitions/TextKey",
          "description": "El que es veu a la llista d'opcions (i el que diu el jugador)."
        },
        "if": {
          "$ref": "#/definitions/Condition"
        },
        "once": {
          "type": "boolean",
          "description": "Desapareix un cop triada."
        },
        "silent": {
          "type": "boolean",
          "description": "El jugador no repeteix el text en veu alta (p. ex. \"(Marxar)\")."
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Effect"
          }
        },
        "next": {
          "$ref": "#/definitions/Id",
          "description": "Node següent. Sense `next`, es torna al mateix node."
        },
        "end": {
          "type": "boolean",
          "description": "Acaba la conversa després de les línies del node `next` (si n'hi ha)."
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    }
  }
}
