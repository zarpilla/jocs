{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CharacterDef": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/definitions/TextKey"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Id"
          },
          "description": "Fets que aquest personatge pot recordar. Serveix per validar el contingut."
        },
        "relation": {
          "type": "object",
          "properties": {
            "initial": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "description": {
          "$ref": "#/definitions/TextKey",
          "description": "Descripció per a \"mirar\" (opcional)."
        },
        "interactions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InteractionDef"
          },
          "description": "Interaccions amb aquest personatge a qualsevol sala (una sala les pot substituir)."
        },
        "appearance": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "if": {
                "$ref": "#/definitions/Condition"
              },
              "anim": {
                "type": "string"
              }
            },
            "required": [
              "anim"
            ],
            "additionalProperties": false
          },
          "description": "Aspecte segons l'estat: la primera entrada que es compleixi diu quina animació (etiqueta del sprite) ha de fer el personatge. Si no se'n compleix cap, la normal. Ex.: el capatàs deixa anar el segell → `{ \"if\": { \"flag\": \"segell_caigut\" }, \"anim\": \"DormSenseSegell\" }`."
        },
        "outfit": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "if": {
                "$ref": "#/definitions/Condition"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "description": "Vestuari segons l'estat: la primera entrada que es compleixi diu quina roba porta (el prefix de les etiquetes del sprite: `Bar` → `BarIdleD`, `BarWalkL`...). Si no se'n compleix cap, la normal. A diferència d'`appearance`, no és una animació fixa: el personatge camina i parla igual."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "TextKey": {
      "type": "string",
      "description": "Clau d'un text a `game/locales/<idioma>/*.json`, p. ex. `\"dlg.pescador.hola\"`."
    },
    "Id": {
      "type": "string"
    },
    "InteractionDef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id",
          "description": "Necessari si `once`: identifica la interacció a les partides desades."
        },
        "verb": {
          "anyOf": [
            {
              "$ref": "#/definitions/Id"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Id"
              }
            }
          ],
          "description": "Verb o verbs del motor (`look`, `use`, `pickUp`...), o `*` per a qualsevol."
        },
        "item": {
          "$ref": "#/definitions/Id",
          "description": "Amb un objecte de l'inventari (\"fer servir X amb...\"). `*` = qualsevol objecte."
        },
        "if": {
          "$ref": "#/definitions/Condition"
        },
        "once": {
          "type": "boolean",
          "description": "Només passa una vegada."
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DialogueLineDef"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Effect"
          }
        },
        "action": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "args": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/Scalar"
              }
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "description": "Acció de la lògica del joc (codi), p. ex. la finestra de fase. `\"$item\"` als args = l'objecte fet servir."
        },
        "dialogue": {
          "$ref": "#/definitions/Id",
          "description": "Comença aquest diàleg després de les línies."
        },
        "goTo": {
          "$ref": "#/definitions/Id",
          "description": "Va a aquesta sala al final."
        }
      },
      "required": [
        "verb"
      ],
      "additionalProperties": false,
      "description": "Què passa quan el jugador fa un verb sobre alguna cosa. S'agafa la primera interacció de la llista que encaixi (verb, objecte, condició, `once`)."
    },
    "Condition": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "flag": {
              "$ref": "#/definitions/Id"
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "flag"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "var": {
              "$ref": "#/definitions/Id"
            },
            "op": {
              "$ref": "#/definitions/CompareOp"
            },
            "value": {
              "$ref": "#/definitions/Scalar"
            }
          },
          "required": [
            "var",
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasItem": {
              "$ref": "#/definitions/Id"
            },
            "who": {
              "$ref": "#/definitions/Id"
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "hasItem"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protagonist": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "protagonist"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "remembers": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "fact": {
                  "$ref": "#/definitions/Id"
                },
                "atLeast": {
                  "type": "number"
                }
              },
              "required": [
                "who",
                "fact"
              ],
              "additionalProperties": false
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "remembers"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "relation": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "op": {
                  "$ref": "#/definitions/CompareOp"
                },
                "value": {
                  "type": "number"
                }
              },
              "required": [
                "who",
                "op",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "relation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quest": {
              "$ref": "#/definitions/Id"
            },
            "status": {
              "anyOf": [
                {
                  "$ref": "#/definitions/QuestStatus"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/QuestStatus"
                  }
                }
              ]
            }
          },
          "required": [
            "quest",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "objective": {
              "type": "object",
              "properties": {
                "quest": {
                  "$ref": "#/definitions/Id"
                },
                "objective": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "quest",
                "objective"
              ],
              "additionalProperties": false
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "objective"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "visited": {
              "$ref": "#/definitions/Id"
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "visited"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "inRoom": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "inRoom"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "seen": {
              "type": "object",
              "properties": {
                "dialogue": {
                  "$ref": "#/definitions/Id"
                },
                "node": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "dialogue",
                "node"
              ],
              "additionalProperties": false
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "seen"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "chosen": {
              "type": "object",
              "properties": {
                "dialogue": {
                  "$ref": "#/definitions/Id"
                },
                "node": {
                  "$ref": "#/definitions/Id"
                },
                "choice": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "dialogue",
                "node",
                "choice"
              ],
              "additionalProperties": false
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "chosen"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Condition"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Condition"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/definitions/Condition"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        }
      ]
    },
    "CompareOp": {
      "type": "string",
      "enum": [
        "==",
        "!=",
        ">",
        ">=",
        "<",
        "<="
      ]
    },
    "Scalar": {
      "type": [
        "number",
        "string",
        "boolean"
      ]
    },
    "QuestStatus": {
      "type": "string",
      "enum": [
        "inactive",
        "active",
        "completed",
        "failed"
      ]
    },
    "DialogueLineDef": {
      "type": "object",
      "properties": {
        "who": {
          "$ref": "#/definitions/SpeakerId"
        },
        "text": {
          "$ref": "#/definitions/TextKey"
        },
        "if": {
          "$ref": "#/definitions/Condition"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Effect"
          }
        },
        "sound": {
          "$ref": "#/definitions/SoundId",
          "description": "So que fa en dir la línia: un fitxer de `game/audio/sfx/` sense extensió. Pot dur variables entre claus, que es posen en acabar la interacció: `\"molla_{molla_tensio}\"` → `molla_3`."
        }
      },
      "required": [
        "who",
        "text"
      ],
      "additionalProperties": false
    },
    "SpeakerId": {
      "anyOf": [
        {
          "$ref": "#/definitions/Id"
        },
        {
          "type": "string",
          "const": "player"
        },
        {
          "type": "string",
          "const": "narrator"
        },
        {
          "type": "string",
          "const": "title"
        }
      ],
      "description": "`player` = el protagonista, `narrator` = text de narració, `title` = pantalla de títol (p. ex. el canvi d'acte): la pantalla es fon a negre, s'hi mostra el text i torna la imatge."
    },
    "Effect": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "setFlag": {
              "$ref": "#/definitions/Id"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "setFlag"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "setVar": {
              "$ref": "#/definitions/Id"
            },
            "value": {
              "$ref": "#/definitions/Scalar"
            }
          },
          "required": [
            "setVar",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "addVar": {
              "$ref": "#/definitions/Id"
            },
            "amount": {
              "type": "number"
            }
          },
          "required": [
            "addVar",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "giveItem": {
              "$ref": "#/definitions/Id"
            },
            "who": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "giveItem"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "takeItem": {
              "$ref": "#/definitions/Id"
            },
            "who": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "takeItem"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "remember": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "fact": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "who",
                "fact"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "remember"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "forget": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "fact": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "who",
                "fact"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "forget"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "relation": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "change": {
                  "type": "number"
                }
              },
              "required": [
                "who",
                "change"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "relation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "startQuest": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "startQuest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "completeObjective": {
              "type": "object",
              "properties": {
                "quest": {
                  "$ref": "#/definitions/Id"
                },
                "objective": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "quest",
                "objective"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "completeObjective"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "completeQuest": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "completeQuest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "failQuest": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "failQuest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ending": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "ending"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string"
            },
            "args": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/Scalar"
              }
            }
          },
          "required": [
            "event"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SoundId": {
      "type": "string",
      "description": "Nom d'un so de `game/audio/sfx/` (sense extensió), amb `{variable}` opcionals."
    }
  },
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    }
  },
  "patternProperties": {
    "^[a-z][a-z0-9_]*$": {
      "$ref": "#/definitions/CharacterDef"
    }
  },
  "additionalProperties": false
}
