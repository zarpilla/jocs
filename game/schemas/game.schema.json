{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/GameFile",
  "definitions": {
    "GameFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "title": {
          "$ref": "#/definitions/TextKey"
        },
        "defaultLocale": {
          "type": "string"
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protagonists": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Id"
          },
          "description": "Personatges que pot controlar el jugador. La primera és la inicial."
        },
        "start": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "room": {
                "$ref": "#/definitions/Id"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/Id"
                }
              }
            },
            "required": [
              "room"
            ],
            "additionalProperties": false
          },
          "description": "On comença cada protagonista i què porta a l'inventari."
        },
        "intro": {
          "$ref": "#/definitions/Id",
          "description": "Sala on comença la partida abans de la de la primera protagonista: un pròleg fet de sales `cutscene` que es porten l'una a l'altra amb `goTo`."
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "defaultLocale",
        "id",
        "locales",
        "protagonists",
        "title"
      ]
    },
    "Id": {
      "type": "string"
    },
    "TextKey": {
      "type": "string",
      "description": "Clau d'un text a `game/locales/<idioma>/*.json`, p. ex. `\"dlg.pescador.hola\"`."
    }
  }
}
