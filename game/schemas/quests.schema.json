{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "QuestDef": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/definitions/TextKey"
        },
        "description": {
          "$ref": "#/definitions/TextKey"
        },
        "kind": {
          "type": "string",
          "enum": [
            "main",
            "side"
          ]
        },
        "startWhen": {
          "$ref": "#/definitions/Condition",
          "description": "S'activa sola quan es compleix."
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/QuestObjectiveDef"
          }
        },
        "completeWhen": {
          "$ref": "#/definitions/Condition",
          "description": "Per defecte, es completa quan tots els objectius no opcionals ho estan."
        },
        "failWhen": {
          "$ref": "#/definitions/Condition"
        },
        "onComplete": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Effect"
          }
        },
        "onFail": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Effect"
          }
        }
      },
      "required": [
        "title",
        "kind",
        "objectives"
      ],
      "additionalProperties": false
    },
    "TextKey": {
      "type": "string",
      "description": "Clau d'un text a `game/locales/<idioma>/*.json`, p. ex. `\"dlg.pescador.hola\"`."
    },
    "Condition": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "flag": {
              "$ref": "#/definitions/Id"
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "flag"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "var": {
              "$ref": "#/definitions/Id"
            },
            "op": {
              "$ref": "#/definitions/CompareOp"
            },
            "value": {
              "$ref": "#/definitions/Scalar"
            }
          },
          "required": [
            "var",
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasItem": {
              "$ref": "#/definitions/Id"
            },
            "who": {
              "$ref": "#/definitions/Id"
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "hasItem"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protagonist": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "protagonist"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "remembers": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "fact": {
                  "$ref": "#/definitions/Id"
                },
                "atLeast": {
                  "type": "number"
                }
              },
              "required": [
                "who",
                "fact"
              ],
              "additionalProperties": false
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "remembers"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "relation": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "op": {
                  "$ref": "#/definitions/CompareOp"
                },
                "value": {
                  "type": "number"
                }
              },
              "required": [
                "who",
                "op",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "relation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quest": {
              "$ref": "#/definitions/Id"
            },
            "status": {
              "anyOf": [
                {
                  "$ref": "#/definitions/QuestStatus"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/QuestStatus"
                  }
                }
              ]
            }
          },
          "required": [
            "quest",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "objective": {
              "type": "object",
              "properties": {
                "quest": {
                  "$ref": "#/definitions/Id"
                },
                "objective": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "quest",
                "objective"
              ],
              "additionalProperties": false
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "objective"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "visited": {
              "$ref": "#/definitions/Id"
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "visited"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "inRoom": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "inRoom"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "seen": {
              "type": "object",
              "properties": {
                "dialogue": {
                  "$ref": "#/definitions/Id"
                },
                "node": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "dialogue",
                "node"
              ],
              "additionalProperties": false
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "seen"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "chosen": {
              "type": "object",
              "properties": {
                "dialogue": {
                  "$ref": "#/definitions/Id"
                },
                "node": {
                  "$ref": "#/definitions/Id"
                },
                "choice": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "dialogue",
                "node",
                "choice"
              ],
              "additionalProperties": false
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "chosen"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Condition"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Condition"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/definitions/Condition"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Id": {
      "type": "string"
    },
    "CompareOp": {
      "type": "string",
      "enum": [
        "==",
        "!=",
        ">",
        ">=",
        "<",
        "<="
      ]
    },
    "Scalar": {
      "type": [
        "number",
        "string",
        "boolean"
      ]
    },
    "QuestStatus": {
      "type": "string",
      "enum": [
        "inactive",
        "active",
        "completed",
        "failed"
      ]
    },
    "QuestObjectiveDef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "text": {
          "$ref": "#/definitions/TextKey"
        },
        "completeWhen": {
          "$ref": "#/definitions/Condition",
          "description": "Es marca sol quan es compleix (es revisa després de cada canvi d'estat)."
        },
        "optional": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    "Effect": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "setFlag": {
              "$ref": "#/definitions/Id"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "setFlag"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "setVar": {
              "$ref": "#/definitions/Id"
            },
            "value": {
              "$ref": "#/definitions/Scalar"
            }
          },
          "required": [
            "setVar",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "addVar": {
              "$ref": "#/definitions/Id"
            },
            "amount": {
              "type": "number"
            }
          },
          "required": [
            "addVar",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "giveItem": {
              "$ref": "#/definitions/Id"
            },
            "who": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "giveItem"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "takeItem": {
              "$ref": "#/definitions/Id"
            },
            "who": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "takeItem"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "remember": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "fact": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "who",
                "fact"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "remember"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "forget": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "fact": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "who",
                "fact"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "forget"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "relation": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "change": {
                  "type": "number"
                }
              },
              "required": [
                "who",
                "change"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "relation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "startQuest": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "startQuest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "completeObjective": {
              "type": "object",
              "properties": {
                "quest": {
                  "$ref": "#/definitions/Id"
                },
                "objective": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "quest",
                "objective"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "completeObjective"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "completeQuest": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "completeQuest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "failQuest": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "failQuest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ending": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "ending"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string"
            },
            "args": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/Scalar"
              }
            }
          },
          "required": [
            "event"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    }
  },
  "patternProperties": {
    "^[a-z][a-z0-9_]*$": {
      "$ref": "#/definitions/QuestDef"
    }
  },
  "additionalProperties": false
}
