{
  "$schema": "../schemas/endings.schema.json",
  "fugida": {
    "title": "final.fugida.titol",
    "text": "final.fugida.text",
    "priority": 1,
    "when": {
      "flag": "fugida_completada"
    }
  },
  "veritat": {
    "title": "final.veritat.titol",
    "text": "final.veritat.text",
    "priority": 2,
    "when": {
      "all": [
        {
          "flag": "fugida_completada"
        },
        {
          "flag": "mira_salvada"
        },
        {
          "flag": "planols_lliurats"
        }
      ]
    }
  },
  "correspondencia": {
    "title": "final.correspondencia.titol",
    "text": "final.correspondencia.text",
    "priority": 3,
    "when": {
      "all": [
        {
          "flag": "fugida_completada"
        },
        {
          "flag": "mira_salvada"
        },
        {
          "flag": "planols_lliurats"
        },
        {
          "flag": "cargol_memoria"
        }
      ]
    }
  }
}
