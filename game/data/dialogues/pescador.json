{
  "$schema": "../../schemas/dialogue.schema.json",
  "id": "pescador",
  "with": "pescador",
  "start": [
    { "if": { "remembers": { "who": "pescador", "fact": "insultat" } }, "node": "rancunios" },
    { "if": { "remembers": { "who": "pescador", "fact": "ajudat" } }, "node": "agrait" },
    { "node": "primera_vegada" }
  ],
  "nodes": {
    "primera_vegada": {
      "lines": [
        { "who": "pescador", "text": "dlg.pescador.hola.1", "if": { "seen": { "dialogue": "pescador", "node": "primera_vegada" }, "is": false } },
        { "who": "pescador", "text": "dlg.pescador.hola.2" }
      ],
      "goto": "menu"
    },
    "rancunios": {
      "lines": [ { "who": "pescador", "text": "dlg.pescador.rancunios" } ],
      "goto": "menu"
    },
    "agrait": {
      "lines": [ { "who": "pescador", "text": "dlg.pescador.agrait" } ],
      "goto": "menu"
    },
    "menu": {
      "choices": [
        {
          "id": "far",
          "text": "dlg.pescador.opt.far",
          "once": true,
          "next": "sobre_el_far",
          "effects": [ { "remember": { "who": "pescador", "fact": "preguntat_far" } } ]
        },
        {
          "id": "insultar",
          "text": "dlg.pescador.opt.insultar",
          "if": { "remembers": { "who": "pescador", "fact": "insultat" }, "is": false },
          "next": "insultat",
          "effects": [
            { "remember": { "who": "pescador", "fact": "insultat" } },
            { "relation": { "who": "pescador", "change": -2 } }
          ]
        },
        {
          "id": "demanar_perdo",
          "text": "dlg.pescador.opt.perdo",
          "once": true,
          "if": { "remembers": { "who": "pescador", "fact": "insultat" } },
          "next": "perdonat",
          "effects": [ { "forget": { "who": "pescador", "fact": "insultat" } }, { "relation": { "who": "pescador", "change": 1 } } ]
        },
        {
          "id": "donar_esquer",
          "text": "dlg.pescador.opt.esquer",
          "if": { "hasItem": "esquer" },
          "next": "gracies_esquer",
          "effects": [
            { "takeItem": "esquer" },
            { "completeObjective": { "quest": "esquer_pescador", "objective": "donar_esquer" } }
          ]
        },
        {
          "id": "clau",
          "text": "dlg.pescador.opt.clau",
          "if": { "all": [
            { "remembers": { "who": "pescador", "fact": "preguntat_far" } },
            { "hasItem": "clau_far", "is": false }
          ] },
          "next": "sobre_la_clau"
        },
        { "id": "adeu", "text": "dlg.pescador.opt.adeu", "next": "adeu", "end": true }
      ]
    },
    "sobre_el_far": {
      "lines": [
        { "who": "pescador", "text": "dlg.pescador.far.1" },
        { "who": "pescador", "text": "dlg.pescador.far.2" }
      ],
      "goto": "menu"
    },
    "insultat": {
      "lines": [ { "who": "pescador", "text": "dlg.pescador.insultat" } ],
      "goto": "menu"
    },
    "perdonat": {
      "lines": [ { "who": "pescador", "text": "dlg.pescador.perdonat" } ],
      "goto": "menu"
    },
    "sobre_la_clau": {
      "lines": [
        { "who": "pescador", "text": "dlg.pescador.clau.no", "if": { "relation": { "who": "pescador", "op": "<", "value": 1 } } },
        { "who": "pescador", "text": "dlg.pescador.clau.encarrec", "if": { "relation": { "who": "pescador", "op": "<", "value": 1 } },
          "effects": [ { "startQuest": "esquer_pescador" } ] },
        { "who": "pescador", "text": "dlg.pescador.clau.si", "if": { "relation": { "who": "pescador", "op": ">=", "value": 1 } },
          "effects": [ { "giveItem": "clau_far" } ] }
      ],
      "goto": "menu"
    },
    "gracies_esquer": {
      "lines": [ { "who": "pescador", "text": "dlg.pescador.gracies" } ],
      "goto": "menu"
    },
    "adeu": {
      "lines": [ { "who": "pescador", "text": "dlg.pescador.adeu", "if": { "relation": { "who": "pescador", "op": ">=", "value": 0 } } },
                 { "who": "pescador", "text": "dlg.pescador.adeu_sec", "if": { "relation": { "who": "pescador", "op": "<", "value": 0 } } } ]
    }
  }
}
