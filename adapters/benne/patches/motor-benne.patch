diff -ruN src/engine/room/characterLights.ts src/engine/room/characterLights.ts
--- src/engine/room/characterLights.ts
+++ src/engine/room/characterLights.ts
@@ -0,0 +1,138 @@
+/**
+ * Character lights: the room's light falls on its characters at runtime.
+ *
+ * The room art is lit when it is drawn (in the content tools); the characters are separate sprites, so without
+ * this they look the same everywhere. A room's {@link RoomCharacterLightsData} lists an ambient and point lights;
+ * each frame the light is sampled at the four corners of every character sprite and set as a per-corner tint in
+ * Phaser's **overlay** tint mode, where `0.5` grey is neutral: below it darkens, above it lightens, and a colour
+ * colours. So one tint both dims a character in a dark corner and lights the side that faces a screen.
+ *
+ * When a room has character lights they replace the region tint (`tintEnabled` regions) for its characters.
+ */
+import * as Phaser from 'phaser';
+
+import type { RoomCharacterLightsData, RoomCharacterLightData } from '../../types/room';
+
+type Rgb = [number, number, number];
+
+function parseHexRgb(hex: string | undefined, fallback: Rgb): Rgb {
+  if (typeof hex !== 'string') {
+    return fallback;
+  }
+  const m = /^#?([0-9a-f]{6})$/i.exec(hex.trim());
+  if (!m) {
+    return fallback;
+  }
+  const n = parseInt(m[1], 16);
+  return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
+}
+
+interface CompiledLight {
+  x: number;
+  y: number;
+  radius: number;
+  squash: number;
+  power: number;
+  rgb: Rgb;
+  whenPropVisible?: string;
+  whenPropHidden?: string;
+}
+
+export interface CompiledCharacterLights {
+  ambient: Rgb;
+  lights: CompiledLight[];
+  /** Fraction of the sprite height, from the top, that samples the light for the top corners. */
+  topSample: number;
+}
+
+const cache = new WeakMap<RoomCharacterLightsData, CompiledCharacterLights>();
+
+/** Parses (once per room data object) the room's character lights; `null` when the room has none. */
+export function compileCharacterLights(data: RoomCharacterLightsData | undefined): CompiledCharacterLights | null {
+  if (!data) {
+    return null;
+  }
+  const hit = cache.get(data);
+  if (hit) {
+    return hit;
+  }
+  const lights = (data.lights ?? []).map((l: RoomCharacterLightData): CompiledLight => {
+    const rgb = parseHexRgb(l.color, [1, 1, 1]);
+    const k = typeof l.intensity === 'number' ? l.intensity : 1;
+    return {
+      x: l.x,
+      y: l.y,
+      radius: Math.max(1, l.radius),
+      squash: l.squash ?? 1,
+      power: l.power ?? 1.6,
+      rgb: [rgb[0] * k, rgb[1] * k, rgb[2] * k],
+      whenPropVisible: l.whenPropVisible,
+      whenPropHidden: l.whenPropHidden,
+    };
+  });
+  const out: CompiledCharacterLights = {
+    ambient: parseHexRgb(data.ambient, [1, 1, 1]),
+    lights,
+    topSample: Math.max(0, Math.min(1, data.topSample ?? 0.15)),
+  };
+  cache.set(data, out);
+  return out;
+}
+
+/** Light (`1` = unlit, per channel) at a room point. */
+export function sampleCharacterLight(
+  cl: CompiledCharacterLights,
+  x: number,
+  y: number,
+  isPropVisible: (propId: string) => boolean,
+): Rgb {
+  const v: Rgb = [cl.ambient[0], cl.ambient[1], cl.ambient[2]];
+  for (const l of cl.lights) {
+    if (l.whenPropVisible && !isPropVisible(l.whenPropVisible)) {
+      continue;
+    }
+    if (l.whenPropHidden && isPropVisible(l.whenPropHidden)) {
+      continue;
+    }
+    const d = Math.hypot(x - l.x, (y - l.y) * l.squash) / l.radius;
+    if (d >= 1) {
+      continue;
+    }
+    const f = Math.pow(1 - d, l.power);
+    v[0] += l.rgb[0] * f;
+    v[1] += l.rgb[1] * f;
+    v[2] += l.rgb[2] * f;
+  }
+  return v;
+}
+
+/** Overlay tint for a light value: half of it (so `1`, unlit, is the neutral `0.5` grey), packed `0xRRGGBB`. */
+function overlayTint(v: Rgb): number {
+  const c = (n: number): number => Math.max(0, Math.min(255, Math.round(n * 0.5 * 255)));
+  return (c(v[0]) << 16) | (c(v[1]) << 8) | c(v[2]);
+}
+
+/**
+ * Lights a character sprite: samples the light at its left and right edges, near the head and at the feet, and
+ * sets the four corner tints in overlay mode.
+ */
+export function applyCharacterLights(
+  sprite: Phaser.GameObjects.Sprite | Phaser.GameObjects.Image,
+  cl: CompiledCharacterLights,
+  isPropVisible: (propId: string) => boolean,
+): void {
+  const b = sprite.getBounds();
+  const top = b.top + b.height * cl.topSample;
+  const bottom = b.bottom;
+  const tl = overlayTint(sampleCharacterLight(cl, b.left, top, isPropVisible));
+  const tr = overlayTint(sampleCharacterLight(cl, b.right, top, isPropVisible));
+  const bl = overlayTint(sampleCharacterLight(cl, b.left, bottom, isPropVisible));
+  const br = overlayTint(sampleCharacterLight(cl, b.right, bottom, isPropVisible));
+  // a flipped sprite swaps its corners: the tint is in room space, so swap them back
+  if (sprite.flipX) {
+    sprite.setTint(tr, tl, br, bl);
+  } else {
+    sprite.setTint(tl, tr, bl, br);
+  }
+  sprite.setTintMode(Phaser.TintModes.OVERLAY);
+}
diff -ruN src/engine/room/characterOutline.ts src/engine/room/characterOutline.ts
--- src/engine/room/characterOutline.ts
+++ src/engine/room/characterOutline.ts
@@ -0,0 +1,146 @@
+/**
+ * Character outline: a dark rim around each character, for rooms whose floor or walls are so bright (white marble,
+ * sunlit water) that the sprites' own edges get lost against them.
+ *
+ * A room's {@link RoomCharacterOutlineData} turns on four copies of each character's current frame, filled with the
+ * outline colour and shifted one step left, right, up and down, just under the character in the room stack: only the
+ * rim around the silhouette shows. The copies use the character's own render nodes and data, so they are sampled
+ * exactly like the character (perspective scale, `artScale` sheets) and stay aligned with it; the room's front
+ * layers cover them the way they cover the character.
+ */
+import * as Phaser from 'phaser';
+
+import type { CharacterData } from '../../types/character';
+import type { RoomCharacterOutlineData } from '../../types/room';
+import { attachBenneCharacterPerspectiveRenderNodes } from '../rendering/benneCharacterPerspectiveBatch';
+
+export interface CompiledCharacterOutline {
+  /** Fill colour (0xRRGGBB). */
+  color: number;
+  /** Opacity of the rim (times the character's own alpha). */
+  alpha: number;
+  /** Thickness in room pixels. */
+  width: number;
+}
+
+const cache = new WeakMap<RoomCharacterOutlineData, CompiledCharacterOutline>();
+
+function num(v: unknown, fallback: number): number {
+  return typeof v === 'number' && Number.isFinite(v) ? v : fallback;
+}
+
+/** Parses (once per room data object) the room's character outline; `null` when the room has none. */
+export function compileCharacterOutline(data: RoomCharacterOutlineData | undefined): CompiledCharacterOutline | null {
+  if (!data || data.enabled === false) {
+    return null;
+  }
+  const hit = cache.get(data);
+  if (hit) {
+    return hit;
+  }
+  const m = typeof data.color === 'string' ? /^#?([0-9a-f]{6})$/i.exec(data.color.trim()) : null;
+  const out: CompiledCharacterOutline = {
+    color: m ? parseInt(m[1], 16) : 0x000000,
+    alpha: Math.max(0, Math.min(1, num(data.alpha, 0.7))),
+    width: Math.max(0.25, num(data.width, 1)),
+  };
+  cache.set(data, out);
+  return out;
+}
+
+type CharacterSprite = Phaser.GameObjects.Sprite | Phaser.GameObjects.Image;
+
+/** The four offsets of the rim copies (left, right, up, down), in units of the outline width. */
+export const OUTLINE_OFFSETS: ReadonlyArray<readonly [number, number]> = [[-1, 0], [1, 0], [0, -1], [0, 1]];
+
+/** Owns the rim copies of each character sprite and keeps them in step with the character every frame. */
+export class CharacterOutlineLayer {
+  private readonly outlines = new Map<CharacterSprite, Phaser.GameObjects.Image[]>();
+
+  private readonly scene: Phaser.Scene;
+
+  constructor(scene: Phaser.Scene) {
+    this.scene = scene;
+  }
+
+  /** Drops every outline (scene teardown destroys the Images themselves). */
+  clear(): void {
+    this.outlines.clear();
+  }
+
+  /** `outline` null = the room has none. */
+  update(outline: CompiledCharacterOutline | null, sprites: Iterable<CharacterSprite>): void {
+    const seen = new Set<CharacterSprite>();
+    if (outline) {
+      for (const sprite of sprites) {
+        if (!sprite.active) {
+          continue;
+        }
+        seen.add(sprite);
+        this.updateOne(outline, sprite);
+      }
+    }
+    for (const [sprite, imgs] of this.outlines) {
+      if (!seen.has(sprite)) {
+        for (const img of imgs) {
+          img.destroy();
+        }
+        this.outlines.delete(sprite);
+      }
+    }
+  }
+
+  private drop(sprite: CharacterSprite): void {
+    for (const img of this.outlines.get(sprite) ?? []) {
+      img.destroy();
+    }
+    this.outlines.delete(sprite);
+  }
+
+  private updateOne(outline: CompiledCharacterOutline, sprite: CharacterSprite): void {
+    const data = sprite.getData('character') as CharacterData | undefined;
+    if (data?.outline === false) {
+      this.drop(sprite);
+      return;
+    }
+    let imgs = this.outlines.get(sprite);
+    if (!imgs) {
+      const created = OUTLINE_OFFSETS.map(() => {
+        const img = this.scene.add.image(0, 0, sprite.texture.key, sprite.frame.name);
+        attachBenneCharacterPerspectiveRenderNodes(img);
+        return img;
+      });
+      imgs = created;
+      this.outlines.set(sprite, created);
+      sprite.once(Phaser.GameObjects.Events.DESTROY, () => {
+        if (this.outlines.get(sprite) === created) {
+          this.drop(sprite);
+        }
+      });
+    }
+    const alpha = outline.alpha * sprite.alpha;
+    const visible = sprite.visible && alpha > 0.001;
+    // Just under the character, above its contact shadow (at depth − 0.5).
+    const depth = sprite.depth - 0.25;
+    OUTLINE_OFFSETS.forEach(([dx, dy], i) => {
+      const img = imgs[i];
+      img.setVisible(visible);
+      if (!visible) {
+        return;
+      }
+      if (img.texture.key !== sprite.texture.key || img.frame.name !== sprite.frame.name) {
+        img.setTexture(sprite.texture.key, sprite.frame.name);
+      }
+      // (the batch reads the character data and the frame: the sheet's artScale and size variant)
+      img.setData('character', data);
+      img.setDepth(depth);
+      img.setFlipX(sprite.flipX);
+      img.setDisplayOrigin(sprite.displayOriginX, sprite.displayOriginY);
+      img.setScale(sprite.scaleX, sprite.scaleY);
+      img.setPosition(sprite.x + dx * outline.width, sprite.y + dy * outline.width);
+      img.setTintMode(Phaser.TintModes.FILL);
+      img.setTint(outline.color);
+      img.setAlpha(alpha);
+    });
+  }
+}
diff -ruN src/engine/room/characterReflection.ts src/engine/room/characterReflection.ts
--- src/engine/room/characterReflection.ts
+++ src/engine/room/characterReflection.ts
@@ -0,0 +1,156 @@
+/**
+ * Floor reflection: a polished floor (marble, wet tiles) mirrors the characters that stand on it.
+ *
+ * The room art already carries the reflection of the room itself (drawn by the content tools); the characters are
+ * separate sprites, so a room's {@link RoomCharacterReflectionData} turns on a copy of each character's current frame
+ * mirrored about its feet: same texture, frame, facing, scale and light tint, faint and fading away from the feet.
+ *
+ * Every reflection sits just above the room background, under all props and characters: the reflection always falls
+ * towards the camera (below the feet on screen), where anything that stands on the floor is in front of the
+ * character anyway, and the room's front layers cover it the way they cover the character.
+ *
+ * Phaser flips a sprite about the middle of its frame, so the mirror is a negative `scaleY` with the display origin
+ * on the feet instead. With a negative scale the frame's top row is drawn at the bottom, so the per-corner tint and
+ * alpha are set in frame space: the "bottom" corners are the ones next to the feet.
+ */
+import * as Phaser from 'phaser';
+
+import type { CharacterData } from '../../types/character';
+import type { RoomCharacterReflectionData } from '../../types/room';
+import { getCharacterWorldFeet } from '../characterFeet';
+
+export interface CompiledCharacterReflection {
+  /** Opacity next to the feet. */
+  alpha: number;
+  /** Opacity at the far end, as a fraction of `alpha` (0 = fades out completely). */
+  fade: number;
+  /** Height of the reflection ÷ height of the character (a high camera sees it shorter). */
+  length: number;
+  /** Below this room y the floor is not polished (or the room ends): the reflection is cut there. */
+  maxY: number | null;
+}
+
+const cache = new WeakMap<RoomCharacterReflectionData, CompiledCharacterReflection>();
+
+function num(v: unknown, fallback: number): number {
+  return typeof v === 'number' && Number.isFinite(v) ? v : fallback;
+}
+
+/** Parses (once per room data object) the room's floor reflection; `null` when the room has none. */
+export function compileCharacterReflection(
+  data: RoomCharacterReflectionData | undefined,
+): CompiledCharacterReflection | null {
+  if (!data || data.enabled === false) {
+    return null;
+  }
+  const hit = cache.get(data);
+  if (hit) {
+    return hit;
+  }
+  const out: CompiledCharacterReflection = {
+    alpha: Math.max(0, Math.min(1, num(data.alpha, 0.2))),
+    fade: Math.max(0, Math.min(1, num(data.fade, 0))),
+    length: Math.max(0.05, num(data.length, 1)),
+    maxY: typeof data.maxY === 'number' && Number.isFinite(data.maxY) ? data.maxY : null,
+  };
+  cache.set(data, out);
+  return out;
+}
+
+type CharacterSprite = Phaser.GameObjects.Sprite | Phaser.GameObjects.Image;
+
+/** Owns one mirrored Image per character sprite and keeps it in step with the character every frame. */
+export class CharacterReflectionLayer {
+  private readonly reflections = new Map<CharacterSprite, Phaser.GameObjects.Image>();
+
+  private readonly scene: Phaser.Scene;
+
+  constructor(scene: Phaser.Scene) {
+    this.scene = scene;
+  }
+
+  /** Drops every reflection (scene teardown destroys the Images themselves). */
+  clear(): void {
+    this.reflections.clear();
+  }
+
+  /**
+   * `reflection` null = the room has no polished floor. `depth`: just above the room background (the lowest sprite
+   * of the room stack).
+   */
+  update(reflection: CompiledCharacterReflection | null, sprites: Iterable<CharacterSprite>, depth: number): void {
+    const seen = new Set<CharacterSprite>();
+    if (reflection) {
+      for (const sprite of sprites) {
+        if (!sprite.active) {
+          continue;
+        }
+        seen.add(sprite);
+        this.updateOne(reflection, sprite, depth);
+      }
+    }
+    for (const [sprite, img] of this.reflections) {
+      if (!seen.has(sprite)) {
+        img.destroy();
+        this.reflections.delete(sprite);
+      }
+    }
+  }
+
+  private updateOne(reflection: CompiledCharacterReflection, sprite: CharacterSprite, depth: number): void {
+    const data = sprite.getData('character') as CharacterData | undefined;
+    let img = this.reflections.get(sprite);
+    if (data?.reflection === false) {
+      if (img) {
+        img.destroy();
+        this.reflections.delete(sprite);
+      }
+      return;
+    }
+    if (!img) {
+      const created = this.scene.add.image(0, 0, sprite.texture.key, sprite.frame.name);
+      img = created;
+      this.reflections.set(sprite, created);
+      sprite.once(Phaser.GameObjects.Events.DESTROY, () => {
+        if (this.reflections.get(sprite) === created) {
+          created.destroy();
+          this.reflections.delete(sprite);
+        }
+      });
+    }
+    const alpha = reflection.alpha * sprite.alpha;
+    const visible = sprite.visible && alpha > 0.001;
+    img.setVisible(visible);
+    if (!visible) {
+      return;
+    }
+    img.setDepth(depth);
+    if (img.texture.key !== sprite.texture.key || img.frame.name !== sprite.frame.name) {
+      img.setTexture(sprite.texture.key, sprite.frame.name);
+    }
+    const feet = getCharacterWorldFeet(sprite as Phaser.GameObjects.Sprite);
+    const sy = sprite.scaleY;
+    // The feet row in frame pixels (from the frame's top), then the mirror about it.
+    const top = sprite.y - sprite.displayOriginY * sy;
+    const feetRow = (feet.y - top) / sy;
+    img.setFlipX(sprite.flipX);
+    img.setDisplayOrigin(sprite.displayOriginX, feetRow);
+    img.setScale(sprite.scaleX, -sy * reflection.length);
+    img.setPosition(sprite.x, feet.y);
+    // Only the part of the frame under the feet would mirror onto the wall: crop the frame to the feet row, and to
+    // the end of the polished floor.
+    const fh = sprite.frame.height;
+    let rows = Math.max(0, Math.min(fh, feetRow));
+    if (reflection.maxY !== null) {
+      const room = (reflection.maxY - feet.y) / (sy * reflection.length);
+      rows = Math.max(0, Math.min(rows, room));
+    }
+    img.setCrop(0, feetRow - rows, sprite.frame.width, rows);
+    // The light falls on the reflection as on the character (frame space: the tints copy as they are).
+    img.setTintMode(sprite.tintMode);
+    img.setTint(sprite.tintTopLeft, sprite.tintTopRight, sprite.tintBottomLeft, sprite.tintBottomRight);
+    // Faint next to the feet (the frame's bottom corners), fading towards the mirrored head (its top corners).
+    const far = alpha * reflection.fade;
+    img.setAlpha(far, far, alpha, alpha);
+  }
+}
diff -ruN src/engine/room/characterShadow.ts src/engine/room/characterShadow.ts
--- src/engine/room/characterShadow.ts
+++ src/engine/room/characterShadow.ts
@@ -0,0 +1,250 @@
+/**
+ * Contact shadow: a dark, semi-transparent ellipse on the floor under each character's feet.
+ *
+ * It is drawn by the engine, not in the character sheet, so it follows the character's perspective scale and the
+ * room's light: a room's {@link RoomCharacterShadowData} turns it on and may name a dominant light (a lamp, a window,
+ * the sun); the shadow then stretches across the floor away from it. The ellipse lives in floor coordinates (x to
+ * the right, z into the room) and is squashed vertically onto the screen, so a stretched shadow keeps lying flat.
+ *
+ * The shadow is a Phaser Graphics just below the character in the room stack (depth − 0.5), redrawn only when its
+ * shape changes.
+ */
+import * as Phaser from 'phaser';
+
+import type { CharacterData } from '../../types/character';
+import type { RoomCharacterShadowData } from '../../types/room';
+import {
+  characterArtScale,
+  characterSpriteArtScale,
+  frameSizeVariantScale,
+  getCharacterWorldFeet,
+} from '../characterFeet';
+
+export interface CompiledCharacterShadow {
+  color: number;
+  alpha: number;
+  squash: number;
+  /** Fraction of the width taken by the darker core (0 = one flat ellipse). */
+  core: number;
+  /** Floor point under the dominant light, room px. */
+  lightPoint: { x: number; y: number } | null;
+  /** Floor direction the shadow falls in (screen px, normalised in floor space) for a far light such as the sun. */
+  direction: { x: number; y: number } | null;
+  stretch: number;
+  reach: number;
+}
+
+const cache = new WeakMap<RoomCharacterShadowData, CompiledCharacterShadow>();
+
+function num(v: unknown, fallback: number): number {
+  return typeof v === 'number' && Number.isFinite(v) ? v : fallback;
+}
+
+/** Parses (once per room data object) the room's contact shadow; `null` when the room has none. */
+export function compileCharacterShadow(data: RoomCharacterShadowData | undefined): CompiledCharacterShadow | null {
+  if (!data || data.enabled === false) {
+    return null;
+  }
+  const hit = cache.get(data);
+  if (hit) {
+    return hit;
+  }
+  const m = typeof data.color === 'string' ? /^#?([0-9a-f]{6})$/i.exec(data.color.trim()) : null;
+  const light = data.light;
+  const out: CompiledCharacterShadow = {
+    color: m ? parseInt(m[1], 16) : 0x000000,
+    alpha: Math.max(0, Math.min(1, num(data.alpha, 0.35))),
+    squash: Math.max(0.05, num(data.squash, 0.3)),
+    core: Math.max(0, Math.min(0.95, num(data.core, 0.6))),
+    lightPoint: light && light.direction !== true ? { x: num(light.x, 0), y: num(light.y, 0) } : null,
+    direction: light && light.direction === true ? { x: num(light.x, 0), y: num(light.y, 0) } : null,
+    stretch: Math.max(0, num(light?.stretch, 0.8)),
+    reach: Math.max(1, num(light?.reach, 120)),
+  };
+  cache.set(data, out);
+  return out;
+}
+
+/** Shadow width at scale 1 (room px): `character.shadow.width`, else from the collider, else from the frame. */
+export function characterShadowBaseWidth(data: CharacterData | undefined, frameWidth: number): number {
+  const s = data?.shadow;
+  if (s && typeof s === 'object' && typeof s.width === 'number' && s.width > 0) {
+    return s.width;
+  }
+  const pts = data?.collider?.points;
+  if (pts && pts.length >= 3) {
+    let lo = Infinity;
+    let hi = -Infinity;
+    for (const p of pts) {
+      lo = Math.min(lo, p.x);
+      hi = Math.max(hi, p.x);
+    }
+    if (hi > lo) {
+      return (hi - lo) * 0.85;
+    }
+  }
+  return (frameWidth / characterArtScale(data)) * 0.4;
+}
+
+export interface ShadowEllipse {
+  /** Centre on screen, room px. */
+  cx: number;
+  cy: number;
+  /** Screen-space outline (room px), closed. */
+  points: { x: number; y: number }[];
+}
+
+/**
+ * The shadow outline for feet at `(feetX, feetY)` and half-width `rx` (room px, already scaled): a floor ellipse
+ * stretched by `1 + stretch` away from the light, with its near end still under the feet.
+ */
+export function shadowEllipse(
+  shadow: CompiledCharacterShadow,
+  feetX: number,
+  feetY: number,
+  rx: number,
+  segments = 24,
+): ShadowEllipse {
+  const q = shadow.squash;
+  // Unit direction the shadow falls in, in floor space (screen y unsquashed), and how far it stretches.
+  let fx = 0;
+  let fz = 0;
+  let stretch = 0;
+  if (shadow.direction) {
+    const len = Math.hypot(shadow.direction.x, shadow.direction.y / q);
+    if (len > 1e-6) {
+      fx = shadow.direction.x / len;
+      fz = shadow.direction.y / q / len;
+      stretch = shadow.stretch;
+    }
+  } else if (shadow.lightPoint) {
+    const dx = feetX - shadow.lightPoint.x;
+    const dz = (feetY - shadow.lightPoint.y) / q;
+    const len = Math.hypot(dx, dz);
+    if (len > 1e-6) {
+      fx = dx / len;
+      fz = dz / len;
+      // Right under the light the shadow is round; it grows to full stretch at `reach`.
+      stretch = shadow.stretch * Math.min(1, len / shadow.reach);
+    }
+  }
+  const along = rx * (1 + stretch);
+  // Centre in floor space: shifted along the fall so the near edge stays under the feet.
+  const czx = fx * rx * stretch;
+  const czz = fz * rx * stretch;
+  const nx = -fz;
+  const nz = fx;
+  const points: { x: number; y: number }[] = [];
+  for (let i = 0; i < segments; i++) {
+    const t = (i / segments) * Math.PI * 2;
+    const c = Math.cos(t);
+    const s = Math.sin(t);
+    // Unstretched (no light): plain circle of radius rx (fx = fz = 0 → use x axis).
+    const ax = stretch > 0 ? fx : 1;
+    const az = stretch > 0 ? fz : 0;
+    const bx = stretch > 0 ? nx : 0;
+    const bz = stretch > 0 ? nz : 1;
+    const px = czx + ax * along * c + bx * rx * s;
+    const pz = czz + az * along * c + bz * rx * s;
+    points.push({ x: feetX + px, y: feetY + pz * q });
+  }
+  return { cx: feetX + czx, cy: feetY + czz * q, points };
+}
+
+type CharacterSprite = Phaser.GameObjects.Sprite | Phaser.GameObjects.Image;
+
+/** Owns one Graphics per character sprite and keeps it under its feet. */
+export class CharacterShadowLayer {
+  private readonly shadows = new Map<CharacterSprite, { g: Phaser.GameObjects.Graphics; key: string }>();
+
+  private readonly scene: Phaser.Scene;
+
+  constructor(scene: Phaser.Scene) {
+    this.scene = scene;
+  }
+
+  /** Drops every shadow (scene teardown destroys the Graphics themselves). */
+  clear(): void {
+    this.shadows.clear();
+  }
+
+  /** Call after the room stack depths are set. `shadow` null = the room has no contact shadow. */
+  update(shadow: CompiledCharacterShadow | null, sprites: Iterable<CharacterSprite>): void {
+    const seen = new Set<CharacterSprite>();
+    if (shadow) {
+      for (const sprite of sprites) {
+        if (!sprite.active) {
+          continue;
+        }
+        seen.add(sprite);
+        this.updateOne(shadow, sprite);
+      }
+    }
+    for (const [sprite, entry] of this.shadows) {
+      if (!seen.has(sprite)) {
+        entry.g.destroy();
+        this.shadows.delete(sprite);
+      }
+    }
+  }
+
+  private updateOne(shadow: CompiledCharacterShadow, sprite: CharacterSprite): void {
+    const data = sprite.getData('character') as CharacterData | undefined;
+    let entry = this.shadows.get(sprite);
+    if (data?.shadow === false) {
+      if (entry) {
+        entry.g.destroy();
+        this.shadows.delete(sprite);
+      }
+      return;
+    }
+    if (!entry) {
+      const g = this.scene.add.graphics();
+      entry = { g, key: '' };
+      this.shadows.set(sprite, entry);
+      sprite.once(Phaser.GameObjects.Events.DESTROY, () => {
+        const e = this.shadows.get(sprite);
+        if (e) {
+          e.g.destroy();
+          this.shadows.delete(sprite);
+        }
+      });
+    }
+    const { g } = entry;
+    const alpha = shadow.alpha * sprite.alpha;
+    const visible = sprite.visible && alpha > 0.001;
+    g.setVisible(visible);
+    g.setDepth(sprite.depth - 0.5);
+    if (!visible) {
+      return;
+    }
+    // `artScale` × the frame's size variant: the perspective scale in 1× frame units.
+    const artScale = characterSpriteArtScale(sprite);
+    const perspective = Math.abs(sprite.scaleX) * artScale;
+    const feet = getCharacterWorldFeet(sprite as Phaser.GameObjects.Sprite);
+    const cfg = data?.shadow && typeof data.shadow === 'object' ? data.shadow : undefined;
+    const fx = feet.x + num(cfg?.offsetX, 0) * perspective;
+    const fy = feet.y + num(cfg?.offsetY, 0) * perspective;
+    const rx = (characterShadowBaseWidth(data, sprite.frame.width / frameSizeVariantScale(sprite)) * perspective) / 2;
+    const key = `${fx.toFixed(2)},${fy.toFixed(2)},${rx.toFixed(3)},${alpha.toFixed(3)}`;
+    if (key === entry.key) {
+      return;
+    }
+    entry.key = key;
+    g.clear();
+    // Two tones: a lighter rim and a darker core, together reaching `alpha` at the centre.
+    const core = shadow.core;
+    const rim = core > 0 ? 1 - Math.sqrt(1 - alpha) : alpha;
+    g.fillStyle(shadow.color, rim);
+    const fill = (r: number): void => {
+      g.fillPoints(
+        shadowEllipse(shadow, fx, fy, r).points.map((p) => new Phaser.Math.Vector2(p.x, p.y)),
+        true,
+      );
+    };
+    fill(rx);
+    if (core > 0) {
+      fill(rx * core);
+    }
+  }
+}
diff -ruN src/engine/room/releaseRoomSheets.ts src/engine/room/releaseRoomSheets.ts
--- src/engine/room/releaseRoomSheets.ts
+++ src/engine/room/releaseRoomSheets.ts
@@ -0,0 +1,40 @@
+/**
+ * Frees the sheets of the rooms that are not on screen.
+ *
+ * A room's sheet (`images/rooms/<id>/<id>.png`, with `artScale: 2` up to 4096 px a side) is loaded when the room is
+ * entered and, without this, stays in GPU memory for the rest of the session: on a phone, after half the game, that
+ * is enough to lose the WebGL context. When a room is created, the sheets of every other room are released: the
+ * texture, the Aseprite JSON in the loader cache (or the loader would skip it next time, as a duplicate key), and the
+ * room's animation clips (the ones whose frames are on that texture). Entering a room again loads it again
+ * ({@link import('../scenes/roomSceneBootstrap').queueRoomSceneAssetLoads} checks `textures.exists`).
+ */
+import type * as Phaser from 'phaser';
+
+import { getRoomAsepriteTextureKey } from '../content/roomAseprite';
+import { isRoomSheetPageTextureKey } from './roomSheetPages';
+
+const SHEET_PREFIX = getRoomAsepriteTextureKey('');
+
+export function releaseOtherRoomSheets(scene: Phaser.Scene, keepRoomId: string): string[] {
+  const keep = getRoomAsepriteTextureKey(keepRoomId);
+  const released: string[] = [];
+  for (const key of scene.textures.getTextureKeys()) {
+    if (isRoomSheetPageTextureKey(key)) {
+      scene.textures.remove(key); // a page of a sheet that was never put together (room/roomSheetPages.ts)
+      continue;
+    }
+    if (!key.startsWith(SHEET_PREFIX) || key === keep) {
+      continue;
+    }
+    const roomId = key.slice(SHEET_PREFIX.length);
+    for (const animKey of scene.anims.getAnimsFromTexture(key)) {
+      scene.anims.remove(animKey);
+    }
+    if (scene.cache.json.exists(key)) {
+      scene.cache.json.remove(key);
+    }
+    scene.textures.remove(key);
+    released.push(roomId);
+  }
+  return released;
+}
diff -ruN src/engine/room/roomSheetPages.ts src/engine/room/roomSheetPages.ts
--- src/engine/room/roomSheetPages.ts
+++ src/engine/room/roomSheetPages.ts
@@ -0,0 +1,80 @@
+/**
+ * A room sheet in several pages.
+ *
+ * A room sheet that does not fit in one 4096×4096 image (the safe maximum on phones), typically with `artScale: 2`
+ * and many animations, comes as pages: `images/rooms/<id>/<id>.png`, `<id>-2.png`... The Aseprite JSON lists them in
+ * `meta.pages`, and each frame says its page (`"page": n`, 0 = the first; the frame rectangle is in that page).
+ *
+ * Each page is loaded as a plain image, and when the room is created they are put together as **one** texture with
+ * several sources (Phaser's multi-source atlas), under the usual room sheet key. Everything else (frame names,
+ * Aseprite animation clips, release when leaving the room) works as with a single page.
+ */
+import type * as Phaser from 'phaser';
+
+import { getNormalizedRoomAsepriteAtlasData } from '../content/loadAsepriteAtlasData';
+import { resolveGameAssetUrl } from '../content/resolveGameAssetUrl';
+import { getRoomAsepriteTextureKey } from '../content/roomAseprite';
+
+const PAGE_PREFIX = 'roomSheetPage:';
+
+/** Texture key of one page while it loads (removed once the pages are put together). */
+export function roomSheetPageTextureKey(roomId: string, page: number): string {
+  return `${PAGE_PREFIX}${roomId}:${page}`;
+}
+
+export function isRoomSheetPageTextureKey(key: string): boolean {
+  return key.startsWith(PAGE_PREFIX);
+}
+
+/** Page image paths (under `assets/`), or `null` for a sheet in one image. */
+export function getRoomSheetPagePaths(roomId: string): string[] | null {
+  const data = getNormalizedRoomAsepriteAtlasData(roomId);
+  const pages = (data.meta as { pages?: unknown } | undefined)?.pages;
+  if (!Array.isArray(pages) || pages.length < 2) {
+    return null;
+  }
+  return pages.map((file) => `images/rooms/${roomId}/${String(file)}`);
+}
+
+/** Queues the page images of a multi-page room sheet. */
+export function queueRoomSheetPages(load: Phaser.Loader.LoaderPlugin, roomId: string, paths: string[]): void {
+  paths.forEach((p, n) => {
+    load.image(roomSheetPageTextureKey(roomId, n), resolveGameAssetUrl(p));
+  });
+}
+
+type FrameEntry = Record<string, unknown> & { page?: number };
+
+/**
+ * When the room sheet comes in pages and they are loaded, builds the room sheet texture from them (and the Aseprite
+ * JSON in the loader cache, for `createFromAseprite`). No-op for a single-page sheet or one already built.
+ */
+export function assembleRoomSheetPages(scene: Phaser.Scene, roomId: string): void {
+  const key = getRoomAsepriteTextureKey(roomId);
+  const paths = getRoomSheetPagePaths(roomId);
+  if (!paths || scene.textures.exists(key)) {
+    return;
+  }
+  const pageKeys = paths.map((_, n) => roomSheetPageTextureKey(roomId, n));
+  if (!pageKeys.every((k) => scene.textures.exists(k))) {
+    console.warn(`[Benne] Room "${roomId}": the pages of its sheet are not loaded.`);
+    return;
+  }
+  const data = getNormalizedRoomAsepriteAtlasData(roomId);
+  const frames = data.frames as Record<string, FrameEntry>;
+  const perPage: Record<string, FrameEntry>[] = paths.map(() => ({}));
+  for (const [name, f] of Object.entries(frames)) {
+    const { page, ...frame } = f;
+    perPage[typeof page === 'number' ? page : 0][name] = frame;
+  }
+  const sources = pageKeys.map((k) => scene.textures.get(k).getSourceImage() as HTMLImageElement);
+  scene.textures.addAtlasJSONHash(
+    key,
+    sources,
+    perPage.map((fr) => ({ frames: fr })),
+  );
+  scene.cache.json.add(key, data);
+  for (const k of pageKeys) {
+    scene.textures.remove(k);
+  }
+}
