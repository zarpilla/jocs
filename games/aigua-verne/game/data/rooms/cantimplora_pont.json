        "all": [
          {
            "var": "escena",
            "op": "==",
            "value": 6
          },
          {
            "flag": "trucada_feta",
            "is": false
          }
        ]
      },
      "once": true,
      "lines": [
        {
          "who": "narrator",
          "text": "sala.cantimplora_pont.entra.1",
          "sound": "pantalla"
        }
      ],
      "effects": [
        {
          "setFlag": "trucada_activa"
        }
      ],
      "dialogue": "trucada"
    },
    {
      "id": "palau_tancat",
      "verb": "*",
      "if": {
        "flag": "palau_tancat"
      },
      "lines": [
        {
          "who": "player",
          "text": "dlg.mapa.palau.1"
        },
        {
          "who": "iri",
          "text": "dlg.mapa.palau.2",
          "if": {
            "not": {
              "hasItem": "vestit_arreglat",
              "who": "iri"
            }
          }
        },
        {
          "who": "iri",
          "text": "dlg.mapa.palau.3",
          "if": {
            "hasItem": "vestit_arreglat",
            "who": "iri"
          }
        }
      ],
      "effects": [
        {
          "setFlag": "palau_tancat",
          "value": false
