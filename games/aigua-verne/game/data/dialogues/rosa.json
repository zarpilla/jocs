{
  "$schema": "../../schemas/dialogue.schema.json",
  "id": "rosa",
  "with": "rosa",
  "start": [
    {
      "if": {
        "all": [
          {
            "flag": "tomas_baixa"
          },
          {
            "not": {
              "seen": {
                "dialogue": "rosa",
                "node": "baixat"
              }
            }
          }
        ]
      },
      "node": "baixat"
    },
    {
      "if": {
        "seen": {
          "dialogue": "rosa",
          "node": "hola"
        }
      },
      "node": "torna"
    },
    {
      "node": "hola"
    }
  ],
  "nodes": {
    "hola": {
      "lines": [
        {
          "who": "rosa",
          "text": "dlg.rosa.hola.1"
        },
        {
          "who": "player",
          "text": "dlg.rosa.hola.2"
        },
        {
          "who": "rosa",
          "text": "dlg.rosa.hola.3",
          "if": {
            "flag": "cal_gala",
            "is": false
          }
        },
        {
          "who": "rosa",
          "text": "dlg.rosa.hola.3.tard",
          "if": {
            "flag": "cal_gala"
          }
        }
      ],
      "goto": "menu"
    },
    "torna": {
      "lines": [
        {
          "who": "rosa",
          "text": "dlg.rosa.torna.1"
        }
      ],
      "goto": "menu"
    },
    "menu": {
      "choices": [
        {
          "id": "vaga",
          "text": "dlg.rosa.opt.vaga",
          "once": true,
          "next": "vaga"
        },
        {
          "id": "vestit",
          "text": "dlg.rosa.opt.vestit",
          "if": {
            "all": [
              {
                "flag": "cal_gala"
              },
              {
                "flag": "rosa_permis",
                "is": false
              },
              {
                "flag": "vestit_agafat",
                "is": false
              },
              {
                "flag": "rosa_vol_tomas",
                "is": false
              }
            ]
          },
          "next": "vestit"
        },
        {
          "id": "vestit_cas",
          "text": "dlg.rosa.opt.vestit_cas",
          "if": {
            "all": [
              {
                "flag": "vestit_volgut"
              },
              {
                "flag": "cal_gala",
                "is": false
              },
              {
                "flag": "rosa_permis",
                "is": false
              }
            ]
          },
          "next": "vestit_cas"
        },
        {
          "id": "vestit_tomas",
          "text": "dlg.rosa.opt.vestit_tomas",
          "if": {
            "all": [
              {
                "flag": "rosa_vol_tomas"
              },
              {
                "flag": "tomas_baixa",
                "is": false
              }
            ]
          },
          "next": "espera"
        },
        {
          "id": "tomas",
          "text": "dlg.rosa.opt.tomas",
          "if": {
            "flag": "tomas_girat"
          },
          "once": true,
          "next": "tomas"
        },
        {
          "id": "adeu",
          "text": "dlg.rosa.opt.adeu",
          "end": true
        }
      ]
    },
    "vestit": {
      "lines": [
        {
          "who": "rosa",
          "text": "dlg.rosa.vestit.1"
        },
        {
          "who": "rosa",
          "text": "dlg.rosa.vestit.3"
        },
        {
          "who": "rosa",
          "text": "dlg.rosa.vestit.4"
        }
      ],
      "effects": [
        {
          "setFlag": "rosa_vol_tomas"
        }
      ],
      "goto": "menu"
    },
    "vaga": {
      "lines": [
        {
          "who": "rosa",
          "text": "dlg.rosa.vaga.1"
        },
        {
          "who": "rosa",
          "text": "dlg.rosa.vaga.2"
        }
      ],
      "goto": "menu"
    },
    "tomas": {
      "lines": [
        {
          "who": "rosa",
          "text": "dlg.rosa.tomas.1"
        }
      ],
      "goto": "menu"
    },
    "espera": {
      "lines": [
        {
          "who": "rosa",
          "text": "dlg.rosa.espera"
        }
      ],
      "goto": "menu"
    },
    "vestit_cas": {
      "lines": [
        {
          "who": "rosa",
          "text": "dlg.rosa.cas.1"
        },
        {
          "who": "player",
          "text": "dlg.rosa.cas.2"
        },
        {
          "who": "rosa",
          "text": "dlg.rosa.cas.3"
        }
      ],
      "effects": [
        {
          "setFlag": "rosa_permis"
        }
      ],
      "goto": "menu"
    },
    "baixat": {
      "lines": [
        {
          "who": "rosa",
          "text": "dlg.rosa.baixat"
        }
      ],
      "goto": "menu"
    }
  }
}
