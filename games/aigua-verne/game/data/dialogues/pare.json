          "next": "temporal"
        },
        {
          "id": "verne",
          "text": "dlg.pare.opt.verne",
          "if": {
            "flag": "caixa_oberta"
          },
          "once": true,
          "next": "verne"
        },
        {
          "id": "escriptura",
          "text": "dlg.pare.opt.escriptura",
          "if": {
            "all": [
              {
                "flag": "caixa_oberta",
                "is": false
              },
              {
                "flag": "quadre_apartat",
                "is": false
              }
            ]
          },
          "next": "escriptura"
        },
        {
          "id": "contrasenya",
          "text": "dlg.pare.opt.contrasenya",
          "if": {
            "all": [
              {
                "flag": "quadre_apartat"
              },
              {
                "flag": "caixa_oberta",
                "is": false
              }
            ]
          },
          "next": "contrasenya"
        },
        {
          "id": "llavors",
          "text": "dlg.pare.opt.llavors",
          "if": {
            "all": [
              {
                "flag": "juana_llavors"
              },
              {
                "flag": "permis_pare",
                "is": false
              }
            ]
          },
          "next": "llavors"
        },
        {
          "id": "reg",
          "text": "dlg.pare.opt.reg",
          "if": {
            "all": [
              {
                "any": [
                  {
                    "flag": "cal_reg"
                  },
                  {
                    "flag": "reg_volgut"
                  }
                ]
              },
              {
                "flag": "permis_reg",
                "is": false
              }
            ]
          },
          "next": "reg"
        },
        {
          "id": "adeu",
          "text": "dlg.pare.opt.adeu",
          "next": "adeu",
          "end": true
        }
      ]
    },
