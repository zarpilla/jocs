            "all": [
              {
                "inRoom": "granja_casa",
                "who": "iri"
              },
              {
                "inRoom": "granja_casa",
                "who": "vet"
              }
            ]
          }
        },
        {
          "who": "quim",
          "text": "dlg.pare.hola.1.iri",
          "if": {
            "not": {
              "all": [
                {
                  "inRoom": "granja_casa",
                  "who": "iri"
                },
                {
                  "inRoom": "granja_casa",
                  "who": "vet"
                }
              ]
            }
          }
        },
        {
          "who": "quim",
          "text": "dlg.pare.hola.2"
        }
