{
  "$schema": "../../schemas/room.schema.json",
  "name": "sala.aeroport_personal.nom",
  "protagonist": "iri",
  "onEnter": [
    {
      "id": "intro",
      "verb": "*",
      "once": true,
      "lines": [
        {
          "who": "player",
          "text": "sala.aeroport_personal.intro1",
          "if": {
            "flag": "soler_distret",
            "is": false
          }
        },
        {
          "who": "player",
          "text": "sala.aeroport_personal.intro1_buscant",
          "if": {
            "flag": "soler_distret"
          }
        }
      ]
    }
  ],
  "hotspots": {
    "teclat": {
      "name": "sala.aeroport_personal.teclat.nom",
      "interactions": [
        {
          "verb": "use",
          "if": {
            "flag": "iri_fora"
          },
          "lines": [
            {
              "who": "player",
              "text": "sala.aeroport_personal.teclat.fora"
            }
          ]
        },
        {
          "verb": "use",
          "if": {
            "flag": "porta_oberta"
          },
          "lines": [
            {
              "who": "player",
              "text": "sala.aeroport_personal.teclat.oberta"
            }
          ],
          "goTo": "aeroport_oficina"
        },
        {
          "verb": "use",
          "if": {
            "flag": "soler_distret",
            "is": false
          },
          "lines": [
            {
              "who": "player",
              "text": "sala.aeroport_personal.teclat.soler"
            }
          ]
        },
        {
          "verb": "use",
          "if": {
            "flag": "alarma_porta"
          },
          "lines": [
            {
              "who": "player",
              "text": "sala.aeroport_personal.teclat.encara"
            }
          ]
        },
        {
          "verb": "use",
          "if": {
            "flag": "codi_porta_llegit"
          },
          "lines": [
            {
              "who": "player",
              "text": "sala.aeroport_personal.teclat.codi",
              "sound": "teclat_porta"
            },
            {
              "who": "narrator",
              "text": "sala.aeroport_personal.teclat.clic"
            }
          ],
          "effects": [
            {
              "setFlag": "porta_oberta"
            }
          ],
          "goTo": "aeroport_oficina"
        },
        {
          "verb": "use",
          "lines": [
            {
              "who": "player",
              "text": "sala.aeroport_personal.teclat.sort"
            },
            {
              "who": "narrator",
              "text": "sala.aeroport_personal.teclat.xiula",
              "sound": "alarma_porta"
            },
            {
              "who": "player",
              "text": "sala.aeroport_personal.teclat.plora"
            }
          ],
          "effects": [
            {
              "setFlag": "alarma_porta"
            },
            {
              "setVar": "alarma",
              "value": 2
            }
          ]
        },
        {
          "verb": "look",
          "lines": [
            {
              "who": "player",
              "text": "sala.aeroport_personal.teclat.look"
            }
          ]
        }
      ]
    },
    "porta": {
      "name": "sala.aeroport_personal.porta.nom",
      "interactions": [
        {
          "verb": [
            "walkTo",
            "use",
            "open"
          ],
          "if": {
            "all": [
              {
                "flag": "porta_oberta"
              },
              {
                "flag": "iri_fora",
                "is": false
              }
            ]
          },
          "goTo": "aeroport_oficina"
        },
        {
          "verb": [
            "open",
            "use"
          ],
          "if": {
            "flag": "iri_fora"
          },
          "lines": [
            {
              "who": "player",
              "text": "sala.aeroport_personal.teclat.fora"
            }
          ]
        },
        {
          "verb": [
            "open",
            "use"
          ],
          "lines": [
            {
              "who": "player",
              "text": "sala.aeroport_personal.porta.tancada"
            }
          ]
        },
        {
          "verb": "look",
          "lines": [
            {
              "who": "player",
              "text": "sala.aeroport_personal.porta.look"
            }
          ]
        }
      ]
    },
    "extintor": {
      "name": "sala.aeroport_personal.extintor.nom",
      "interactions": [
        {
          "verb": "look",
          "lines": [
            {
              "who": "player",
              "text": "sala.aeroport_personal.extintor.look"
            }
          ]
        }
      ]
    },
    "tauler": {
      "name": "sala.aeroport_personal.tauler.nom",
      "interactions": [
        {
          "verb": "look",
          "lines": [
            {
              "who": "player",
              "text": "sala.aeroport_personal.tauler.look"
            }
          ]
        }
      ]
    },
    "taquilles": {
      "name": "sala.aeroport_personal.taquilles.nom",
      "interactions": [
        {
          "verb": "look",
          "lines": [
            {
              "who": "player",
              "text": "sala.aeroport_personal.taquilles.look"
            }
          ]
        }
      ]
    },
    "carro": {
      "name": "sala.aeroport_personal.carro.nom",
      "interactions": [
        {
          "verb": "look",
          "lines": [
            {
              "who": "player",
              "text": "sala.aeroport_personal.carro.look"
            }
          ]
        }
      ]
    },
    "con": {
      "name": "sala.aeroport_personal.con.nom",
      "interactions": [
        {
          "verb": "look",
          "lines": [
            {
              "who": "player",
              "text": "sala.aeroport_personal.con.look"
            }
          ]
        }
      ]
    }
  },
  "decor": {
    "soler_vidre": {
      "visibleIf": {
        "flag": "soler_distret",
        "is": false
      }
    },
    "porta_oberta": {
      "visibleIf": {
        "flag": "porta_oberta"
      }
    },
    "alarma": {
      "visibleIf": {
        "flag": "alarma_porta"
      }
    }
  }
}
