{
  "$schema": "../../schemas/dialogue.schema.json",
  "id": "trucada",
  "with": "iri",
  "start": [
    {
      "node": "hola"
    }
  ],
  "nodes": {
    "hola": {
      "lines": [
        {
          "who": "player",
          "text": "dlg.trucada.hola",
          "sound": "telefon_bar"
        },
        {
          "who": "iri",
          "text": "dlg.trucada.hola2"
        }
      ],
      "goto": "menu"
    },
    "menu": {
      "choices": [
        {
          "id": "pany",
          "text": "dlg.trucada.opt.pany",
          "if": {
            "all": [
              {
                "flag": "sap_pany"
              },
              {
                "flag": "cal_contrasenya",
                "is": false
              }
            ]
          },
          "next": "pany"
        },
        {
          "id": "contrasenya",
          "text": "dlg.trucada.opt.contrasenya",
          "if": {
            "all": [
              {
                "flag": "contrasenya_llegida"
              },
              {
                "flag": "contrasenya_dita",
                "is": false
              }
            ]
          },
          "next": "contrasenya"
        },
        {
          "id": "trucada",
          "text": "dlg.trucada.opt.trucada",
          "if": {
            "all": [
              {
                "flag": "sap_dona"
              },
              {
                "flag": "trucada_demanada",
                "is": false
              }
            ]
          },
          "next": "trucada"
        },
        {
          "id": "resum",
          "text": "dlg.trucada.opt.resum",
          "if": {
            "all": [
              {
                "flag": "marcel_fet"
              },
              {
                "flag": "resum_fet",
                "is": false
              }
            ]
          },
          "next": "resum"
        },
        {
          "id": "robot",
          "text": "dlg.trucada.opt.robot",
          "if": {
            "all": [
              {
                "flag": "resum_fet"
              },
              {
                "flag": "marcel_neta"
              },
              {
                "flag": "iri_sap_neta",
                "is": false
              }
            ]
          },
          "next": "robot"
        },
        {
          "id": "adeu",
          "text": "dlg.trucada.opt.adeu",
          "next": "adeu",
          "end": true
        }
      ]
    },
    "pany": {
      "effects": [
        {
          "setFlag": "cal_contrasenya"
        }
      ],
      "lines": [
        {
          "who": "iri",
          "text": "dlg.trucada.pany1"
        },
        {
          "who": "iri",
          "text": "dlg.trucada.pany2"
        }
      ],
      "goto": "menu"
    },
    "contrasenya": {
      "effects": [
        {
          "setFlag": "contrasenya_dita"
        }
      ],
      "lines": [
        {
          "who": "iri",
          "text": "dlg.trucada.contrasenya"
        }
      ],
      "goto": "menu"
    },
    "trucada": {
      "effects": [
        {
          "setFlag": "trucada_demanada"
        }
      ],
      "lines": [
        {
          "who": "iri",
          "text": "dlg.trucada.trucada1"
        },
        {
          "who": "iri",
          "text": "dlg.trucada.trucada2"
        }
      ],
      "goto": "menu"
    },
    "resum": {
      "effects": [
        {
          "setFlag": "resum_fet"
        }
      ],
      "lines": [
        {
          "who": "player",
          "text": "dlg.trucada.resum1"
        },
        {
          "who": "player",
          "text": "dlg.trucada.resum2"
        },
        {
          "who": "player",
          "text": "dlg.trucada.resum3"
        },
        {
          "who": "player",
          "text": "dlg.trucada.resum4"
        },
        {
          "who": "player",
          "text": "dlg.trucada.resum5",
          "if": {
            "flag": "marcel_ballester"
          }
        },
        {
          "who": "iri",
          "text": "dlg.trucada.resum6"
        },
        {
          "who": "iri",
          "text": "dlg.trucada.resum7"
        }
      ],
      "goto": "menu"
    },
    "robot": {
      "effects": [
        {
          "setFlag": "iri_sap_neta"
        }
      ],
      "lines": [
        {
          "who": "iri",
          "text": "dlg.trucada.robot"
        }
      ],
      "goto": "menu"
    },
    "adeu": {
      "lines": [
        {
          "who": "iri",
          "text": "dlg.trucada.adeu"
        }
      ]
    }
  }
}
