{
  "$schema": "../../schemas/dialogue.schema.json",
  "id": "despatx",
  "with": "bonfill",
  "start": [
    {
      "if": {
        "flag": "virus_aturat"
      },
      "node": "despres"
    },
    {
      "if": {
        "flag": "sync_mobil"
      },
      "node": "sync"
    },
    {
      "node": "hola"
    }
