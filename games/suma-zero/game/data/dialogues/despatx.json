            "all": [
              {
                "flag": "gos_preguntat",
                "is": false
              },
              {
                "flag": "sap_rockefeller"
              }
            ]
          },
          "next": "gos"
        },
        {
          "id": "gos_nom",
          "text": "dlg.despatx.opt.gos_nom",
