          "who": "bonfill",
          "text": "dlg.despatx.sync"
        }
      ],
      "goto": "eines"
    },
    "eines": {
      "choices": [
        {
          "id": "reunio",
          "text": "dlg.despatx.opt.reunio",
          "if": {
            "flag": "reunio1",
            "is": false
          },
          "next": "reunio"
        },
        {
          "id": "reunio2",
          "text": "dlg.despatx.opt.reunio2",
          "if": {
            "all": [
              {
                "flag": "reunio1"
              },
              {
                "flag": "reunio2",
                "is": false
              }
            ]
          },
          "next": "reunio2"
        },
        {
          "id": "gos",
          "text": "dlg.despatx.opt.gos_sync",
