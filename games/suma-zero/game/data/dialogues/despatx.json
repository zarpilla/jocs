      "lines": [
        {
          "who": "bonfill",
          "text": "dlg.despatx.hola"
        }
      ],
      "goto": "menu"
    },
    "menu": {
      "choices": [
        {
          "id": "gos",
          "text": "dlg.despatx.opt.gos",
          "once": true,
          "next": "gos_fora"
        },
        {
          "id": "adeu",
          "text": "dlg.despatx.opt.adeu",
          "end": true
        }
      ]
    },
    "gos_fora": {
