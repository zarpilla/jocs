            "all": [
              {
                "flag": "gos_preguntat",
                "is": false
              },
              {
                "flag": "sap_rockefeller",
                "is": false
              }
            ]
          },
          "next": "gos"
        },
        {
          "id": "pons",
          "text": "dlg.despatx.opt.pons",
          "silent": true,
          "if": {
            "all": [
              {
                "flag": "aliada_pons"
              },
              {
                "flag": "mobil_resolt",
                "is": false
              }
            ]
          },
          "next": "pons"
        },
        {
          "id": "ballester",
          "text": "dlg.despatx.opt.ballester",
          "silent": true,
          "if": {
            "all": [
              {
                "flag": "ballester_acompanya"
              },
              {
                "flag": "mobil_resolt",
                "is": false
              }
            ]
          },
          "next": "ballester"
        },
        {
          "id": "adeu",
          "text": "dlg.despatx.opt.adeu_sync",
          "end": true
        }
      ]
