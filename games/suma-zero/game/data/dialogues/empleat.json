{
  "$schema": "../../schemas/dialogue.schema.json",
  "id": "empleat",
  "with": "empleat",
  "start": [
    {
      "node": "hola"
    }
  ],
  "nodes": {
    "hola": {
      "lines": [
        {
          "who": "empleat",
          "text": "dlg.empleat.hola"
        }
      ],
      "goto": "menu"
    },
    "menu": {
      "choices": [
        {
          "id": "maleti",
          "text": "dlg.empleat.opt.maleti",
          "if": {
            "hasItem": "maleti",
            "is": false
          },
          "next": "maleti"
        },
        {
          "id": "adeu",
          "text": "dlg.empleat.opt.adeu",
          "next": "adeu",
          "end": true
        }
      ]
    },
    "maleti": {
      "lines": [
        {
          "who": "empleat",
          "text": "dlg.empleat.maleti"
        }
      ],
      "choices": [
        {
          "id": "papers",
          "text": "dlg.empleat.opt.papers",
          "next": "papers"
        },
        {
          "id": "agenda",
          "text": "dlg.empleat.opt.agenda",
          "if": {
            "flag": "maleti_vist"
          },
          "next": "agenda"
        },
        {
          "id": "llimona",
          "text": "dlg.empleat.opt.llimona",
          "if": {
            "all": [
              {
                "flag": "maleti_vist"
              },
              {
                "flag": "maleti_olor"
              }
            ]
          },
          "next": "llimona"
        },
        {
          "id": "oblit",
          "text": "dlg.empleat.opt.oblit",
          "next": "oblit"
        }
      ]
    },
    "llimona": {
      "effects": [
        {
          "giveItem": "maleti"
        }
      ],
      "lines": [
        {
          "who": "empleat",
          "text": "dlg.empleat.llimona1"
        },
        {
          "who": "narrator",
          "text": "dlg.empleat.llimona2"
        }
      ],
      "goto": "menu"
    },
    "papers": {
      "lines": [
        {
          "who": "empleat",
          "text": "dlg.empleat.papers"
        }
      ],
      "effects": [
        {
          "setFlag": "maleti_olor"
        }
      ],
      "goto": "menu"
    },
    "agenda": {
      "lines": [
        {
          "who": "empleat",
          "text": "dlg.empleat.agenda"
        }
      ],
      "effects": [
        {
          "setFlag": "maleti_olor"
        }
      ],
      "goto": "menu"
    },
    "oblit": {
      "lines": [
        {
          "who": "empleat",
          "text": "dlg.empleat.oblit"
        }
      ],
      "goto": "menu"
    },
    "adeu": {
      "lines": [
        {
          "who": "empleat",
          "text": "dlg.empleat.adeu"
        }
      ]
    }
  }
}
