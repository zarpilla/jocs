{
  "$schema": "../../schemas/dialogue.schema.json",
  "id": "llibre",
  "with": "iri",
  "start": [
    {
      "node": "pista"
    }
  ],
  "nodes": {
    "pista": {
      "lines": [
        {
          "who": "narrator",
          "text": "dlg.llibre.pista"
        },
        {
          "who": "player",
          "text": "dlg.llibre.pista_no",
          "if": {
            "flag": "sap_rockefeller",
            "is": false
          }
        },
        {
          "who": "player",
          "text": "dlg.llibre.pista_si",
          "if": {
            "all": [
              {
                "flag": "sap_rockefeller"
              },
              {
                "flag": "sap_any_gos",
                "is": false
              }
            ]
          }
        },
        {
          "who": "player",
          "text": "dlg.llibre.pista_tot",
          "if": {
            "all": [
              {
                "flag": "sap_rockefeller"
              },
              {
                "flag": "sap_any_gos"
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "setFlag": "pista_contrasenya"
        }
      ],
      "goto": "menu"
    },
    "menu": {
      "choices": [
        {
          "id": "bonfill",
          "text": "dlg.llibre.opt.bonfill",
          "next": "mal"
        },
        {
          "id": "diners",
          "text": "dlg.llibre.opt.diners",
          "next": "mal"
        },
        {
          "id": "rockefeller",
          "text": "dlg.llibre.opt.rockefeller",
          "if": {
            "flag": "sap_rockefeller"
          },
          "next": "nomes_nom"
        },
        {
          "id": "rockefeller_any",
          "text": "dlg.llibre.opt.rockefeller_any",
          "if": {
            "all": [
              {
                "flag": "sap_rockefeller"
              },
              {
                "flag": "sap_any_gos"
              }
            ]
          },
          "next": "ok"
        },
        {
          "id": "sostenibilitat",
          "text": "dlg.llibre.opt.sostenibilitat",
          "next": "mal"
        },
        {
          "id": "adeu",
          "text": "dlg.llibre.opt.adeu",
          "silent": true,
          "end": true
        }
      ]
    },
    "mal": {
      "lines": [
        {
          "who": "narrator",
          "text": "dlg.llibre.mal"
        }
      ],
      "goto": "menu"
    },
    "nomes_nom": {
      "lines": [
        {
          "who": "narrator",
          "text": "dlg.llibre.mal_any"
        },
        {
          "who": "player",
          "text": "dlg.llibre.mal_any2",
          "if": {
            "flag": "sap_any_gos",
            "is": false
          }
        }
      ],
      "goto": "menu"
    },
    "ok": {
      "lines": [
        {
          "who": "narrator",
          "text": "dlg.llibre.ok1"
        },
        {
          "who": "player",
          "text": "dlg.llibre.ok2"
        },
        {
          "who": "vet",
          "text": "dlg.llibre.ok3"
        }
      ],
      "effects": [
        {
          "setFlag": "contrasenya_ok"
        },
        {
          "setFlag": "sync_mobil"
        },
        {
          "setVar": "torns_mobil",
          "value": 9
        },
        {
          "setVar": "coberta_mobil",
          "value": 0
        }
      ]
    }
  }
}
