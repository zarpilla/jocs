    "apotecaria": "claustre",
    "bugaderia": "preparacio",
    "porteria": "nit",
    "cuina": "nit",
    "scriptorium": "arxiu",
    "arxiu": "arxiu",
    "moli": "fugida",
    "judici": "mati",
    "epileg": "final",
    "credits": "final",
    "postcredits": "final"
  }
