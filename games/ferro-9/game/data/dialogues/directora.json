{
  "$schema": "../../schemas/dialogue.schema.json",
  "id": "directora",
  "with": "directora",
  "start": [
    {
      "if": {
        "flag": "vet_fugida_cella"
      },
      "node": "tornada"
    },
    {
      "if": {
        "hasItem": "tub_amb_llibreta",
        "who": "vet"
      },
      "node": "tub"
    },
    {
      "if": {
        "flag": "pacte_acceptat"
      },
      "node": "hola_pacte"
    },
    {
      "if": {
        "seen": {
          "dialogue": "directora",
          "node": "primera"
        }
      },
      "node": "hola"
    },
    {
      "node": "primera"
    }
  ],
  "nodes": {
    "primera": {
      "lines": [
        {
          "who": "directora",
          "text": "dlg.directora.primera1"
        },
        {
          "who": "directora",
          "text": "dlg.directora.primera2"
        },
        {
          "who": "directora",
          "text": "dlg.directora.primera3"
        },
        {
          "who": "directora",
          "text": "dlg.directora.primera4",
          "effects": [
            {
              "setFlag": "vet_sap_tub"
            }
          ]
        }
      ],
      "goto": "menu"
    },
    "hola": {
      "lines": [
        {
          "who": "directora",
          "text": "dlg.directora.hola"
        }
      ],
      "goto": "menu"
    },
    "menu": {
      "choices": [
        {
          "id": "que_vol",
          "text": "dlg.directora.opt.que_vol",
          "next": "que_vol"
        },
        {
          "id": "iri",
          "text": "dlg.directora.opt.iri",
          "next": "iri",
          "once": true
        },
        {
          "id": "pacte",
          "text": "dlg.directora.opt.pacte",
          "next": "pacte",
          "once": true,
          "effects": [
            {
              "setFlag": "pacte_acceptat"
            }
          ]
        },
        {
          "id": "no",
          "text": "dlg.directora.opt.no",
          "next": "no",
          "if": {
            "flag": "pacte_acceptat",
            "is": false
          }
        },
        {
          "id": "adeu",
          "text": "dlg.directora.opt.adeu",
          "next": "adeu",
          "end": true,
          "if": {
            "flag": "pacte_acceptat",
            "is": false
          }
        },
        {
          "id": "adeu_pacte",
          "text": "dlg.directora.opt.adeu_pacte",
          "next": "adeu_pacte",
          "end": true,
          "if": {
            "flag": "pacte_acceptat"
          }
        }
      ]
    },
    "que_vol": {
      "lines": [
        {
          "who": "directora",
          "text": "dlg.directora.que_vol1"
        },
        {
          "who": "directora",
          "text": "dlg.directora.que_vol2"
        },
        {
          "who": "directora",
          "text": "dlg.directora.que_vol.3",
          "if": {
            "flag": "tub_muntat",
            "is": false
          }
        }
      ],
      "goto": "menu"
    },
    "iri": {
      "lines": [
        {
          "who": "directora",
          "text": "dlg.directora.iri1"
        },
        {
          "who": "directora",
          "text": "dlg.directora.iri2"
        }
      ],
      "goto": "menu"
    },
    "no": {
      "lines": [
        {
          "who": "directora",
          "text": "dlg.directora.no1"
        },
        {
          "who": "directora",
          "text": "dlg.directora.no2"
        }
      ],
      "goto": "menu"
    },
    "adeu": {
      "lines": [
        {
          "who": "directora",
          "text": "dlg.directora.adeu"
        }
      ]
    },
    "pacte": {
      "lines": [
        {
          "who": "directora",
          "text": "dlg.directora.pacte1"
        },
        {
          "who": "directora",
          "text": "dlg.directora.pacte2"
        }
      ],
      "goto": "menu"
    },
    "tornada": {
      "lines": [
        {
          "who": "directora",
          "text": "dlg.directora.tornada1"
        },
        {
          "who": "player",
          "text": "dlg.directora.tornada2"
        },
        {
          "who": "directora",
          "text": "dlg.directora.tornada3"
        }
      ]
    },
    "tub": {
      "lines": [
        {
          "who": "directora",
          "text": "dlg.directora.tub1"
        },
        {
          "who": "player",
          "text": "dlg.directora.tub2"
        }
      ]
    },
    "hola_pacte": {
      "lines": [
        {
          "who": "directora",
          "text": "dlg.directora.hola_pacte"
        }
      ],
      "goto": "menu"
    },
    "adeu_pacte": {
      "lines": [
        {
          "who": "directora",
          "text": "dlg.directora.adeu_pacte"
        }
      ]
    }
  }
}
