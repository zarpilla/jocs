{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/RoomFile",
  "definitions": {
    "RoomFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/definitions/TextKey"
        },
        "protagonist": {
          "$ref": "#/definitions/Id",
          "description": "De quina protagonista és la sala (informatiu, i per validar)."
        },
        "protagonists": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Id"
          },
          "description": "Sala compartida: hi pot entrar qualsevol d'aquestes protagonistes, i les dues hi poden ser alhora (es veuen l'una a l'altra). Qui hi entra és qui juga; en canviar de protagonista, es va on és l'altra. Substitueix `protagonist`."
        },
        "onEnter": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InteractionDef"
          },
          "description": "En entrar-hi, s'executa la primera que encaixi (el `verb` s'ignora: posa `*`)."
        },
        "hotspots": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/HotspotDef"
          },
          "description": "Coses de la sala: props, zones i personatges, amb l'id que tenen al motor."
        },
        "decor": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/DecorDef"
          },
          "description": "Decorats condicionals: dibuixos que es veuen quan es compleix `visibleIf`, però no es poden clicar (p. ex. un panell obert damunt del panell tancat). Els clics passen a la cosa de sota."
        },
        "cutscene": {
          "type": "object",
          "properties": {
            "skipTo": {
              "$ref": "#/definitions/Id"
            }
          },
          "additionalProperties": false,
          "description": "Sala de cinemàtica (p. ex. el pròleg): no hi ha cap protagonista, l'adaptador amaga la interfície, i l'`onEnter` es reprodueix sol fins al `goTo`. Si el jugador la salta, es va directament a `skipTo`. Si té `hotspots` (la carta de navegació d'Aigua Verne), en acabar l'`onEnter` s'hi queda i es poden tocar, sense que ningú hi camini."
        },
        "narrador": {
          "type": "string",
          "enum": [
            "esquerra",
            "dreta"
          ],
          "description": "On surt la caixa del narrador en aquesta sala, si no és a dalt al mig (p. ex. `esquerra` a la presentació de L'Última Arrel, perquè no tapi la pantalla gegant mentre el text l'explica)."
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "hotspots",
        "name"
      ]
    },
    "TextKey": {
      "type": "string",
      "description": "Clau d'un text a `game/locales/<idioma>/*.json`, p. ex. `\"dlg.pescador.hola\"`."
    },
    "Id": {
      "type": "string"
    },
    "InteractionDef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id",
          "description": "Necessari si `once`: identifica la interacció a les partides desades."
        },
        "verb": {
          "anyOf": [
            {
              "$ref": "#/definitions/Id"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Id"
              }
            }
          ],
          "description": "Verb o verbs del motor (`look`, `use`, `pickUp`...), o `*` per a qualsevol."
        },
        "item": {
          "$ref": "#/definitions/Id",
          "description": "Amb un objecte de l'inventari (\"fer servir X amb...\"). `*` = qualsevol objecte."
        },
        "if": {
          "$ref": "#/definitions/Condition"
        },
        "once": {
          "type": "boolean",
          "description": "Només passa una vegada."
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DialogueLineDef"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Effect"
          }
        },
        "action": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "args": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/Scalar"
              }
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "description": "Acció de la lògica del joc (codi), p. ex. la finestra de fase. `\"$item\"` als args = l'objecte fet servir."
        },
        "dialogue": {
          "$ref": "#/definitions/Id",
          "description": "Comença aquest diàleg després de les línies."
        },
        "goTo": {
          "$ref": "#/definitions/Id",
          "description": "Va a aquesta sala al final."
        },
        "walkIn": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "description": "Només a l'`onEnter`: la protagonista entra caminant des de fora de la pantalla, per aquest costat, fins al seu lloc de la sala, i després diu les línies."
        }
      },
      "required": [
        "verb"
      ],
      "additionalProperties": false,
      "description": "Què passa quan el jugador fa un verb sobre alguna cosa. S'agafa la primera interacció de la llista que encaixi (verb, objecte, condició, `once`)."
    },
    "Condition": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "flag": {
              "$ref": "#/definitions/Id"
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "flag"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "var": {
              "$ref": "#/definitions/Id"
            },
            "op": {
              "$ref": "#/definitions/CompareOp"
            },
            "value": {
              "$ref": "#/definitions/Scalar"
            }
          },
          "required": [
            "var",
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hasItem": {
              "$ref": "#/definitions/Id"
            },
            "who": {
              "$ref": "#/definitions/Id"
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "hasItem"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protagonist": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "protagonist"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "remembers": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "fact": {
                  "$ref": "#/definitions/Id"
                },
                "atLeast": {
                  "type": "number"
                }
              },
              "required": [
                "who",
                "fact"
              ],
              "additionalProperties": false
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "remembers"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "relation": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "op": {
                  "$ref": "#/definitions/CompareOp"
                },
                "value": {
                  "type": "number"
                }
              },
              "required": [
                "who",
                "op",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "relation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quest": {
              "$ref": "#/definitions/Id"
            },
            "status": {
              "anyOf": [
                {
                  "$ref": "#/definitions/QuestStatus"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/QuestStatus"
                  }
                }
              ]
            }
          },
          "required": [
            "quest",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "objective": {
              "type": "object",
              "properties": {
                "quest": {
                  "$ref": "#/definitions/Id"
                },
                "objective": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "quest",
                "objective"
              ],
              "additionalProperties": false
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "objective"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "visited": {
              "$ref": "#/definitions/Id"
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "visited"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "inRoom": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Id"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Id"
                  }
                }
              ]
            },
            "who": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "inRoom"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "seen": {
              "type": "object",
              "properties": {
                "dialogue": {
                  "$ref": "#/definitions/Id"
                },
                "node": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "dialogue",
                "node"
              ],
              "additionalProperties": false
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "seen"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "chosen": {
              "type": "object",
              "properties": {
                "dialogue": {
                  "$ref": "#/definitions/Id"
                },
                "node": {
                  "$ref": "#/definitions/Id"
                },
                "choice": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "dialogue",
                "node",
                "choice"
              ],
              "additionalProperties": false
            },
            "is": {
              "type": "boolean"
            }
          },
          "required": [
            "chosen"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Condition"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Condition"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/definitions/Condition"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        }
      ]
    },
    "CompareOp": {
      "type": "string",
      "enum": [
        "==",
        "!=",
        ">",
        ">=",
        "<",
        "<="
      ]
    },
    "Scalar": {
      "type": [
        "number",
        "string",
        "boolean"
      ]
    },
    "QuestStatus": {
      "type": "string",
      "enum": [
        "inactive",
        "active",
        "completed",
        "failed"
      ]
    },
    "DialogueLineDef": {
      "type": "object",
      "properties": {
        "who": {
          "$ref": "#/definitions/SpeakerId"
        },
        "text": {
          "$ref": "#/definitions/TextKey"
        },
        "if": {
          "$ref": "#/definitions/Condition"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Effect"
          }
        },
        "sound": {
          "$ref": "#/definitions/SoundId",
          "description": "So que fa en dir la línia: un fitxer de `game/audio/sfx/` sense extensió. Pot dur variables entre claus, que es posen en acabar la interacció: `\"molla_{molla_tensio}\"` → `molla_3`."
        },
        "stage": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StageCue"
          },
          "description": "Moviment abans de dir la línia (qui camina, s'asseu, apareix o marxa), per ordre. Només és visual: l'estat no en sap res, i en acabar les línies el motor torna a posar cada personatge com diu l'estat. A l'`onEnter`, el de la primera línia (menys el que camina) ja es fa abans que es vegi la sala."
        },
        "stageAfter": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/StageCue"
          },
          "description": "Moviment en acabar de dir la línia (p. ex. qui diu «me'n vaig» i després marxa), com `stage`."
        },
        "itemsNow": {
          "type": "boolean",
          "description": "Els objectes que donen o treuen els `effects` d'aquesta línia (`giveItem`, `takeItem`) entren o surten de l'inventari quan es diu la línia (després del seu `stage`), no en acabar-les totes (p. ex. «La Urtica agafa el pot»). Per a l'estat, com sempre: tots els efectes s'apliquen abans de les línies."
        }
      },
      "required": [
        "who",
        "text"
      ],
      "additionalProperties": false
    },
    "SpeakerId": {
      "anyOf": [
        {
          "$ref": "#/definitions/Id"
        },
        {
          "type": "string",
          "const": "player"
        },
        {
          "type": "string",
          "const": "narrator"
        },
        {
          "type": "string",
          "const": "title"
        }
      ],
      "description": "`player` = el protagonista, `narrator` = text de narració, `title` = pantalla de títol (p. ex. el canvi d'acte): la pantalla es fon a negre, s'hi mostra el text i torna la imatge. Una línia del narrador amb el text buit (`\"\"`) és un silenci: només les indicacions d'escena i el so, sense caixa."
    },
    "Effect": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "setFlag": {
              "$ref": "#/definitions/Id"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "setFlag"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "setVar": {
              "$ref": "#/definitions/Id"
            },
            "value": {
              "$ref": "#/definitions/Scalar"
            }
          },
          "required": [
            "setVar",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "addVar": {
              "$ref": "#/definitions/Id"
            },
            "amount": {
              "type": "number"
            }
          },
          "required": [
            "addVar",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "giveItem": {
              "$ref": "#/definitions/Id"
            },
            "who": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "giveItem"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "takeItem": {
              "$ref": "#/definitions/Id"
            },
            "who": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "takeItem"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "remember": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "fact": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "who",
                "fact"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "remember"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "forget": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "fact": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "who",
                "fact"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "forget"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "relation": {
              "type": "object",
              "properties": {
                "who": {
                  "$ref": "#/definitions/Id"
                },
                "change": {
                  "type": "number"
                }
              },
              "required": [
                "who",
                "change"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "relation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "startQuest": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "startQuest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "completeObjective": {
              "type": "object",
              "properties": {
                "quest": {
                  "$ref": "#/definitions/Id"
                },
                "objective": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "quest",
                "objective"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "completeObjective"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "completeQuest": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "completeQuest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "failQuest": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "failQuest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ending": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "ending"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string"
            },
            "args": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/Scalar"
              }
            }
          },
          "required": [
            "event"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SoundId": {
      "type": "string",
      "description": "Nom d'un so de `game/audio/sfx/` (sense extensió), amb `{variable}` opcionals."
    },
    "StageCue": {
      "type": "object",
      "properties": {
        "who": {
          "anyOf": [
            {
              "$ref": "#/definitions/Id"
            },
            {
              "type": "string",
              "const": "player"
            }
          ]
        },
        "prop": {
          "$ref": "#/definitions/Id",
          "description": "Una capa del decorat (un prop del motor), en lloc d'un personatge."
        },
        "hold": {
          "type": "number",
          "description": "Després de la indicació, s'espera aquests segons sense text (p. ex. mentre dura l'animació d'un prop). En saltar la cinemàtica, no s'espera."
        },
        "shake": {
          "type": "number",
          "description": "Sacseja la pantalla aquests segons (no s'espera)."
        },
        "at": {
          "anyOf": [
            {
              "$ref": "#/definitions/Id"
            },
            {
              "$ref": "#/definitions/StagePoint"
            }
          ],
          "description": "S'hi posa de cop."
        },
        "walk": {
          "anyOf": [
            {
              "$ref": "#/definitions/Id"
            },
            {
              "$ref": "#/definitions/StagePoint"
            }
          ],
          "description": "Hi camina."
        },
        "wait": {
          "type": "boolean",
          "description": "Amb `walk`: `false` = no s'espera que hi arribi (camina mentre es diu la línia). Per defecte, s'espera."
        },
        "face": {
          "type": "string",
          "enum": [
            "L",
            "R",
            "U",
            "D"
          ]
        },
        "anim": {
          "type": [
            "string",
            "null"
          ],
          "description": "Animació del sprite (p. ex. `Seu`); `null` la treu (torna a estar dret)."
        },
        "gest": {
          "type": [
            "string",
            "null"
          ],
          "description": "Un gest (p. ex. `Fa`, fer anar una cosa amb les mans): l'animació `<roba><gest><direcció>` del sprite (`LlunyFaL`), amb la roba que porta a la sala i cap on mira ara (gireu-lo abans amb `face`); `null` el treu."
        },
        "visible": {
          "type": "boolean"
        },
        "fade": {
          "type": "number",
          "description": "Amb `prop` i `visible: true`: la capa apareix fosa, de transparent a opaca en aquests segons (p. ex. l'aigua de la resclosa que baixa). No s'espera: amb `hold`, sí."
        },
        "fosc": {
          "type": "boolean",
          "description": "La foscor de la sala (`fosc` al mapping de Benne) es posa al dia en aquesta línia, i no abans: els efectes s'apliquen abans de dir les línies, i sense això el generador s'aturaria (o tornaria la llum) a la primera."
        }
      },
      "additionalProperties": false,
      "description": "Una indicació d'escena: `who` (un personatge, o `player` per a la protagonista que juga) i què fa, en aquest ordre: es posa a `at`, es mostra o s'amaga (`visible`), canvia d'animació (`anim`), es gira (`face`) i camina fins a `walk`. Els llocs són una cosa o un personatge de la sala (hi va al seu punt d'arribada) o un punt.\n\nEn lloc de `who`, `prop`: una capa del decorat de la sala que no és al JSON del joc (l'art del motor, p. ex. la zòdiac del pròleg de Ni un ou), que només es mostra o s'amaga (`visible`) i canvia d'animació (`anim`).\n\n`shake` sacseja la pantalla (p. ex. la paret que vibra al pròleg de Ferro-9); pot anar sol, sense `who` ni `prop`."
    },
    "StagePoint": {
      "type": "object",
      "properties": {
