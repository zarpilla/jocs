{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/StateFile",
  "definitions": {
    "StateFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flags": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "vars": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Scalar"
          }
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "flags",
        "vars"
      ]
    },
    "Scalar": {
      "type": [
        "number",
        "string",
        "boolean"
      ]
    }
  }
}
