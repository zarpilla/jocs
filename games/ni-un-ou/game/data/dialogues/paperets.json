{
  "$schema": "../../schemas/dialogue.schema.json",
  "id": "paperets",
  "with": "vet",
  "start": "proposta",
  "nodes": {
    "proposta": {
      "lines": [
        {
          "who": "player",
          "text": "dlg.paperets.proposta.1",
          "if": {
            "not": {
              "any": [
                {
                  "chosen": {
                    "dialogue": "paperets",
                    "node": "proposta",
                    "choice": "flam"
                  }
                },
                {
                  "chosen": {
                    "dialogue": "paperets",
                    "node": "proposta",
                    "choice": "ernest"
                  }
                }
              ]
            }
          }
        },
        {
          "who": "player",
          "text": "dlg.paperets.proposta.2",
          "if": {
            "any": [
              {
                "chosen": {
                  "dialogue": "paperets",
                  "node": "proposta",
                  "choice": "flam"
                }
              },
              {
                "chosen": {
                  "dialogue": "paperets",
                  "node": "proposta",
                  "choice": "ernest"
                }
              }
            ]
          }
        }
      ],
      "choices": [
        {
          "id": "flam",
          "text": "dlg.paperets.opt.flam",
          "once": true,
          "next": "flam"
        },
        {
          "id": "ernest",
          "text": "dlg.paperets.opt.ernest",
          "if": {
            "flag": "prova_cambra"
          },
          "once": true,
          "next": "ernest"
        },
        {
          "id": "postres",
          "text": "dlg.paperets.opt.postres",
          "next": "postres"
        },
        {
          "id": "adeu",
          "text": "dlg.paperets.opt.adeu",
          "silent": true,
          "end": true
        }
      ]
    },
    "flam": {
      "lines": [
        {
          "who": "narrator",
          "text": "dlg.paperets.flam.1",
          "sound": "muntacarregues"
        },
        {
          "who": "narrator",
          "text": "dlg.paperets.flam.2"
        }
      ],
      "goto": "proposta"
    },
    "ernest": {
      "lines": [
        {
          "who": "narrator",
          "text": "dlg.paperets.ernest.1",
          "sound": "muntacarregues"
        },
        {
          "who": "narrator",
          "text": "dlg.paperets.ernest.2"
        },
        {
          "who": "player",
          "text": "dlg.paperets.ernest.3"
        }
      ],
      "effects": [
        {
          "setFlag": "vet_sospita"
        }
      ],
      "goto": "proposta"
    },
    "postres": {
      "lines": [
        {
          "who": "narrator",
          "text": "dlg.paperets.postres.1",
          "sound": "muntacarregues"
        },
        {
          "who": "narrator",
          "text": "dlg.paperets.postres.2"
        }
      ],
      "effects": [
        {
          "setFlag": "mentida_triada"
        }
      ]
    }
  }
}
